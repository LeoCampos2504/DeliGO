// DeliGO - Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CLIENTES
// ============================================
model Cliente {
  id               String   @id @default(cuid())
  nombre           String
  email            String   @unique
  password         String?
  googleId         String?  @unique
  telefono         String   @default("")
  pushSubscription String?
  fechaRegistro    DateTime @default(now())

  // Email verification
  emailVerified     DateTime?
  verificationToken String?   @unique

  // Protección contra clientes maliciosos
  bloqueado              Boolean   @default(false)
  bloqueadoFecha         DateTime?
  ultimoIp               String    @default("")
  dispositivoFingerprint String    @default("")

  direcciones  Direccion[]
  favoritos    Favorito[]
  pedidos      Pedido[]
  resenas      Resena[]
  chatMensajes ChatMensaje[]
  denuncias    Denuncia[]

  @@map("clientes")
}

model Direccion {
  id         String  @id @default(cuid())
  alias      String
  direccion  String
  referencia String  @default("")
  lat        Float?
  lng        Float?
  clienteId  String
  cliente    Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("direcciones")
}

model Favorito {
  id        String  @id @default(cuid())
  clienteId String
  negocioId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([clienteId, negocioId])
  @@map("favoritos")
}

// ============================================
// NEGOCIOS
// ============================================
model Negocio {
  id         String  @id @default(cuid())
  slug       String  @unique
  nombre     String  @unique
  usuario    String  @unique
  email      String  @unique @default("pending@deligo.app")
  password   String
  rubro      String  @default("restaurante") // restaurante, ropa, otro
  aprobado   Boolean @default(false)
  suspendido Boolean @default(false)

  // Email verification
  emailVerified     DateTime?
  verificationToken String?   @unique

  // Personalización visual
  colorPrincipal    String  @default("#FB8C00")
  mensajeBienvenida String  @default("")
  logoEnCirculo     Boolean @default(false)
  colorCirculoLogo  String  @default("")
  colorFondo        String  @default("")

  // Categorías de productos
  categorias String @default("[]") // JSON array of strings

  // Categorías de agregados e ingredientes
  agregadosCategorias    String @default("[]") // JSON array of strings
  ingredientesCategorias String @default("[]") // JSON array of strings

  // Secciones del catálogo
  seccionesCatalogo String @default("[]") // JSON array of section objects

  // Horarios (JSON: keys "1"-"7" with apertura/cierre/turno2 etc.)
  horarios      String  @default("{}")
  horarioMode   String  @default("experto") // "simple" = toggle manual, "experto" = horarios por día
  abiertoManual Boolean @default(true) // solo aplica cuando horarioMode = "simple"

  // Redes sociales
  whatsapp  String @default("")
  instagram String @default("")
  facebook  String @default("")

  // Imágenes
  logoUrl        String?
  bannerUrl      String?
  fondoImagenUrl String?

  // Delivery
  ofreceDelivery        Boolean @default(false)
  // T20-DK1 (Dark Kitchen): capacidad de Retiro independiente de Delivery —
  // default true conserva EXACTAMENTE el comportamiento de todos los
  // negocios existentes (retiro estaba siempre disponible antes de este
  // campo). false + ofreceDelivery=true habilita la modalidad "solo delivery".
  ofreceRetiro          Boolean @default(true)
  zonaDeliveryActiva    Boolean @default(false)
  zonasDelivery         String  @default("[]") // JSON array of zone objects
  precioDelivery        Float   @default(0)
  precioDeliveryDefault Float   @default(0)
  deliveryMode          String  @default("") // modo de delivery

  // Ubicación del negocio
  lat Float?
  lng Float?
  // P0-B: marca que `lat`/`lng` fueron confirmados explícitamente por el
  // Negocio (acción "Confirmar ubicación del local"), no solo que existen —
  // las coordenadas pueden venir de otro flujo (p. ej. delivery) sin haber
  // sido calibradas para validar pedidos de mesa. `null` = sin calibrar.
  ubicacionCalibradaEn DateTime?

  // Configuración visual/panel
  mostrarVentas             Boolean   @default(false)
  panelMode                 String    @default("")
  promocionado              Boolean   @default(false)
  ordenPromocion            Int       @default(0)
  destacadoHasta            DateTime? // fecha hasta la cual el negocio es destacado
  seguimientoDeliveryActivo Boolean   @default(false)

  // Salón / Mesas
  salonActivo      Boolean @default(false)
  empleadosActivos Boolean @default(false)
  zonasSalon       String  @default("[]") // JSON array of zone names

  // Pago
  aceptaTransferencia Boolean @default(false)
  aliasBancario       String  @default("")

  // Configuración de pedidos
  toleranciaCancelacion Int @default(5) // minutes
  tiempoEntrega         Int @default(30) // minutes

  // Repartidores
  repartidorCodigo String? @unique

  // Access token for employees (single shared link for pedidos + reseñas)
  tokenEmpleados String? @unique // token for /e/[token] — combined employee view

  // Access token for salon (shared link for mesas/orders view)
  tokenSalon String? @unique // token for /s/[token] — salon mesas view

  // Relations (salón)
  mesas     Mesa[]
  empleados Empleado[]
  codigosIncorporacionMozo CodigoIncorporacionMozo[]
  terminalesOperativas       TerminalOperativa[]
  vinculacionesTerminalOperativa VinculacionTerminalOperativa[]

  // Plan
  planTipo            String  @default("prueba")
  planVencimiento     String?
  planFechaInicio     String?
  planFechaRenovacion String?

  // Push
  pushSubscription          String?
  // Separate push subscriptions for the shared-display PWAs:
  //  - pushSubscriptionSalon:      /s/[token] salon view (kitchen/tablet)
  //  - pushSubscriptionEmpleados:  /e/[token] empleados panel (pedidos + reseñas)
  // These are intentionally separate from `pushSubscription` (which is the
  // business owner's personal subscription on the /negocio panel) so a
  // single device can subscribe on multiple shared displays without wiping
  // the owner's subscription.
  pushSubscriptionSalon     String?
  pushSubscriptionEmpleados String?

  // Monetización
  deudaTarifa Float  @default(0)
  limiteDeuda Float?

  // Rating cache
  puntuacionPromedio Float @default(0)
  totalResenas       Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productos            Producto[]
  agregados            Agregado[]
  ingredientes         Ingrediente[]
  pedidos              Pedido[]
  resenas              Resena[]
  solicitudesRevisionResena SolicitudRevisionResena[]
  favoritos            Favorito[]
  deudaHistorial       DeudaHistorial[]
  repartidores         RepartidorNegocio[]
  secciones            SeccionCatalogo[]
  opcionesCompartidas  OpcionesCompartidas[]
  promociones          Promocion[]
  denuncias            Denuncia[]
  solicitudesDestacado DestacadoSolicitud[]
  ocupacionesMesa      SesionOcupacionMesa[]

  @@map("negocios")
}

// ============================================
// SECCIONES CATÁLOGO
// ============================================
model SeccionCatalogo {
  id          String  @id @default(cuid())
  nombre      String
  orientacion String  @default("vertical") // horizontal, vertical
  orden       Int     @default(0)
  color       String  @default("")
  negocioId   String
  negocio     Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  productos SeccionProducto[]

  @@map("secciones_catalogo")
}

model SeccionProducto {
  id         String          @id @default(cuid())
  seccionId  String
  productoId String
  seccion    SeccionCatalogo @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  producto   Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  orden      Int             @default(0)

  @@unique([seccionId, productoId])
  @@map("seccion_productos")
}

// ============================================
// PRODUCTOS
// ============================================
model Producto {
  id            String  @id @default(cuid())
  nombre        String
  precio        Float
  categoria     String  @default("Sin Categoria")
  imagenUrl     String?
  imagenesExtra String  @default("[]") // JSON array of URLs
  negocioId     String
  stock         Boolean @default(true)
  eliminado     Boolean @default(false)

  // Descuentos
  descuentoActivo Boolean @default(false)
  tipoDescuento   String  @default("porcentaje") // porcentaje, monto
  valorDescuento  Float   @default(0)

  // Restaurante
  descripcion            String?
  secciones              String  @default("[]") // JSON: product option sections
  recomendados           String  @default("[]") // JSON array of product IDs
  opcionesCompartidasIds String  @default("[]") // JSON array of shared option IDs

  // Ropa
  talles   String @default("[]") // JSON array
  colores  String @default("[]") // JSON array
  material String @default("")
  genero   String @default("")

  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocio      Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  agregados    ProductoAgregado[]
  ingredientes ProductoIngrediente[]
  seccionItems SeccionProducto[]
  itemsPedido  PedidoItem[]
  promociones  Promocion[]

  @@map("productos")
}

model ProductoAgregado {
  id         String   @id @default(cuid())
  productoId String
  agregadoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  agregado   Agregado @relation(fields: [agregadoId], references: [id], onDelete: Cascade)

  @@unique([productoId, agregadoId])
  @@map("producto_agregados")
}

model ProductoIngrediente {
  id            String      @id @default(cuid())
  productoId    String
  ingredienteId String
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@unique([productoId, ingredienteId])
  @@map("producto_ingredientes")
}

// ============================================
// AGREGADOS (Add-ons)
// ============================================
model Agregado {
  id        String  @id @default(cuid())
  nombre    String
  precio    Float   @default(0)
  categoria String  @default("")
  imagenUrl String?
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  productos ProductoAgregado[]

  @@map("agregados")
}

// ============================================
// INGREDIENTES
// ============================================
model Ingrediente {
  id        String  @id @default(cuid())
  nombre    String
  categoria String  @default("")
  imagenUrl String?
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  productos ProductoIngrediente[]

  @@map("ingredientes")
}

// ============================================
// PEDIDOS (Orders)
// ============================================
model Pedido {
  id              String  @id @default(cuid())
  negocioId       String
  negocioSlug     String
  negocioNombre   String
  clienteId       String?
  clienteNombre   String
  clienteTelefono String  @default("")

  // Totales
  total          Float
  totalProductos Float
  tarifaServicio Float @default(0)
  precioDelivery Float @default(0)

  // Entrega
  metodoEntrega String  @default("retiro") // retiro, domicilio, mesa
  direccion     String?
  referencia    String?
  lat           Float?
  lng           Float?

  // Mesa / Salón
  mesaId          String?
  mesaNumero      Int?
  empleadoId      String?
  empleadoNombre  String?
  // P0-D.1: preparado, todavía sin usar — P0-D.2 recién empezará a escribirlo
  // y a exigir la credencial en POST /api/pedidos. Todos los pedidos
  // existentes y los nuevos de esta etapa quedan en NULL. SetNull: si la
  // ocupación se borra, el pedido nunca debe borrarse con ella (mismo patrón
  // que Pedido.cliente).
  ocupacionMesaId String?

  // Idempotencia de operaciones
  idempotencyKey         String?
  idempotencyFingerprint String?

  // Ubicación negocio al momento del pedido
  negocioLat Float?
  negocioLng Float?

  // Repartidor asignado (aceptación de pedido)
  repartidorId          String? // ID del repartidor que aceptó el pedido
  repartidorNombre      String? // Nombre del repartidor (denormalizado)
  repartidorAceptaFecha DateTime? // Cuándo aceptó el pedido

  // Ubicación repartidor en tiempo real (seguimiento delivery)
  repartidorLat        Float?
  repartidorLng        Float?
  repartidorLastUpdate DateTime?

  // Pago
  metodoPago String  @default("efectivo") // efectivo, transferencia
  notas      String?

  // Estado
  estado                  String    @default("recibido") // recibido, preparando, en_camino, listo_para_retirar, entregado, cancelado
  deudaAcumulada          Boolean   @default(false)
  canceladoPor            String? // cliente, vendedor, sistema
  canceladoMotivo         String?
  canceladoFecha          DateTime?
  clienteConfirmaRecibido Boolean   @default(false)
  clienteConfirmaFecha    DateTime?
  entregadoPorRepartidor  Boolean   @default(false)
  entregadoFecha          DateTime?

  fecha     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  negocio       Negocio              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cliente       Cliente?             @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  items         PedidoItem[]
  mensajes      ChatMensaje[]
  resena        Resena?
  eventos       PedidoEvento[]
  ocupacionMesa SesionOcupacionMesa? @relation(fields: [ocupacionMesaId], references: [id], onDelete: SetNull)

  @@unique([negocioId, idempotencyKey])
  @@index([ocupacionMesaId])
  @@map("pedidos")
}

model PedidoItem {
  id                   String  @id @default(cuid())
  pedidoId             String
  productoId           String?
  nombre               String
  precio               Float
  cantidad             Int     @default(1)
  agregados            String  @default("[]") // JSON: [{id, nombre, precio}]
  secciones            String  @default("{}") // JSON: {sectionName: option}
  seccionesPrecios     String  @default("{}") // JSON: {key: price}
  ingredientes         String  @default("[]") // JSON
  ingredientesQuitados String  @default("[]") // JSON
  talle                String  @default("")
  color                String  @default("")

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id])

  @@map("pedido_items")
}

// ============================================
// CHAT
// ============================================
model ChatMensaje {
  id            String   @id @default(cuid())
  pedidoId      String
  remitente     String // cliente, vendedor, repartidor
  texto         String   @default("")
  imagenUrl     String?
  archivoUrl    String?
  archivoNombre String?
  archivoTipo   String?
  leido         Boolean  @default(false)
  fecha         DateTime @default(now())

  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId String?

  @@map("chat_mensajes")
}

// ============================================
// RESEÑAS
// ============================================
enum EstadoModeracionResena {
  PUBLICADA
  OCULTA_EN_REVISION
  ELIMINADA_POR_MODERACION
}

enum EstadoSolicitudRevisionResena {
  PENDIENTE
  EN_REVISION
  REQUIERE_INFORMACION
  APROBADA
  RECHAZADA
  RESTAURADA_AUTOMATICAMENTE
}

enum MotivoSolicitudRevisionResena {
  FALSA
  ILEGAL
  OFENSIVA
  DISCRIMINATORIA
  OTRA_INFRACCION
}

enum TipoEventoSolicitudRevisionResena {
  SOLICITUD_CREADA
  TOMADA_EN_REVISION
  INFORMACION_REQUERIDA
  INFORMACION_APORTADA
  APROBADA
  RECHAZADA
  RESTAURADA_AUTOMATICAMENTE
}

enum ActorSolicitudRevisionResena {
  NEGOCIO
  SUPERADMIN
  SISTEMA
}

model Resena {
  id               String    @id @default(cuid())
  negocioId        String
  clienteId        String?
  clienteNombre    String
  pedidoId         String    @unique
  puntuacion       Int // 1-5
  comentario       String    @default("")
  rapidez          Int?
  calidad          Int?
  precio           Int?
  respuestaNegocio String?
  fechaRespuesta   DateTime?
  fecha            DateTime  @default(now())
  // Fuente de verdad de visibilidad pública. La solicitud conserva el expediente
  // y la reseña nunca se borra cuando la moderación aprueba una eliminación.
  estadoModeracion EstadoModeracionResena @default(PUBLICADA)
  moderadaEn       DateTime?

  negocio             Negocio                    @relation(fields: [negocioId], references: [id])
  cliente             Cliente?                   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  pedido              Pedido                     @relation(fields: [pedidoId], references: [id])
  solicitudesRevision SolicitudRevisionResena[]

  // Habilita la FK compuesta SolicitudRevisionResena(resenaId, negocioId), que
  // evita asociar en DB una reseña de un negocio con otro negocio distinto.
  @@unique([id, negocioId])
  @@map("resenas")
}

// Expediente de una solicitud del dueño del negocio. `activeKey` es la garantía
// de una sola solicitud activa: para PENDIENTE/EN_REVISION/REQUIERE_INFORMACION
// vale resenaId; para estados terminales vale NULL. El CHECK versionado en la
// migración refuerza esa correspondencia que Prisma no puede expresar.
model SolicitudRevisionResena {
  id                       String                        @id @default(cuid())
  resenaId                 String
  negocioId                String
  motivo                   MotivoSolicitudRevisionResena
  explicacionOriginal      String
  estado                   EstadoSolicitudRevisionResena @default(PENDIENTE)
  activeKey                String?                       @unique
  venceEn                  DateTime
  resueltaEn               DateTime?
  revisadaPorSuperadminId  String?
  motivoDecision           String?
  prorrogaInformacionUsada Boolean                       @default(false)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  resena                Resena                    @relation(fields: [resenaId, negocioId], references: [id, negocioId], onDelete: Restrict)
  negocio               Negocio                   @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  revisadaPorSuperadmin SuperAdmin?               @relation(fields: [revisadaPorSuperadminId], references: [id], onDelete: Restrict)
  eventos               SolicitudRevisionResenaEvento[]
  evidencias            EvidenciaSolicitudRevisionResena[]

  @@index([negocioId, estado, createdAt])
  @@index([estado, venceEn])
  @@index([resenaId, createdAt])
  @@map("solicitudes_revision_resena")
}

// Línea de tiempo append-only del expediente. `metadata` conserva solo datos
// sanitizados/no sensibles serializados como JSON; nunca contenido binario.
model SolicitudRevisionResenaEvento {
  id          String                            @id @default(cuid())
  solicitudId String
  tipo        TipoEventoSolicitudRevisionResena
  actorTipo   ActorSolicitudRevisionResena
  actorId     String?
  mensaje     String?
  metadata    String                            @default("{}")
  createdAt   DateTime                          @default(now())

  solicitud  SolicitudRevisionResena           @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  evidencias EvidenciaSolicitudRevisionResena[]

  @@index([solicitudId, createdAt])
  @@map("solicitudes_revision_resena_eventos")
}

// Solo metadata privada preparada para 19-F. No guarda URL pública, contenido
// ni rutas locales arbitrarias; storageKey se resolverá por un proxy autorizado.
model EvidenciaSolicitudRevisionResena {
  id                  String                          @id @default(cuid())
  solicitudId         String
  eventoId            String?
  uploaderTipo        ActorSolicitudRevisionResena
  uploaderId          String?
  storageKey          String                          @unique
  mimeType            String
  bytes               Int
  sha256              String
  nombrePresentacion  String
  createdAt           DateTime                        @default(now())

  solicitud SolicitudRevisionResena        @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  evento    SolicitudRevisionResenaEvento? @relation(fields: [eventoId], references: [id], onDelete: Restrict)

  @@index([solicitudId, createdAt])
  @@map("evidencias_solicitud_revision_resena")
}

// ============================================
// REPARTIDORES
// ============================================
model Repartidor {
  id               String   @id @default(cuid())
  nombre           String
  email            String   @unique
  password         String?
  googleId         String?  @unique
  telefono         String   @default("")
  pushSubscription String?
  activo           Boolean  @default(true)
  eliminado        Boolean  @default(false)
  fechaRegistro    DateTime @default(now())

  // Email verification
  emailVerified     DateTime?
  verificationToken String?   @unique

  negocios RepartidorNegocio[]

  @@map("repartidores")
}

model RepartidorNegocio {
  id              String   @id @default(cuid())
  repartidorId    String
  negocioId       String
  negocioSlug     String
  negocioNombre   String
  negocioLogoUrl  String?
  codigoAcceso    String
  fechaAsociacion DateTime @default(now())

  repartidor Repartidor @relation(fields: [repartidorId], references: [id], onDelete: Cascade)
  negocio    Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([repartidorId, negocioId])
  @@map("repartidor_negocios")
}

// ============================================
// SUPERADMIN
// ============================================
// 24-A: Google-only con bootstrap seguro.
// "password" queda nullable y sin uso — código de login por clave común
// retirado (src/app/api/auth/login/route.ts). No se elimina la columna acá
// para no forzar una migración destructiva sobre datos legacy.
// "googleSub" (claim `sub` de Google, @unique) es la única autoridad de
// identidad estable una vez vinculada — el email nunca la reemplaza. La
// unicidad a nivel de base es lo que garantiza que un bootstrap concurrente
// nunca vincule dos filas a la misma identidad de Google.
model SuperAdmin {
  id               String   @id @default(cuid())
  password         String?
  email            String?
  googleSub        String?  @unique
  activo           Boolean  @default(true)
  pushSubscription String?
  createdAt        DateTime @default(now())

  solicitudesRevisionResenaRevisadas SolicitudRevisionResena[]

  @@map("super_admins")
}

// ============================================
// DEUDA HISTORIAL
// ============================================
model DeudaHistorial {
  id            String   @id @default(cuid())
  negocioId     String
  negocioNombre String
  montoAbonado  Float
  deudaAnterior Float
  fechaAbono    DateTime @default(now())
  tipo          String   @default("abono_total")

  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@map("deuda_historial")
}

// ============================================
// SESIONES
// ============================================
model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  userType  String // cliente, negocio, repartidor, superadmin
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sesiones")
}

// ============================================
// RECUPERACIÓN DE CONTRASEÑA (Bugfix-5D)
// ============================================
// Modelo genérico y pequeño — resuelve la cuenta vía userType + userId, sin
// una FK polimórfica hacia cuatro tablas distintas (mismo patrón que ya usa
// Sesion.userType). Nunca guarda el token real: solo su hash SHA-256
// (tokenHash), igual que Sesion.token y que CodigoIncorporacionMozo.codeHash.
// Valores permitidos de userType: cliente | negocio | repartidor |
// cuenta_operativa — nunca superadmin (sin email) ni terminal (no es una
// cuenta personal). El allowlist se valida en la aplicación
// (src/lib/password-reset.ts), no en el schema.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  userType  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userType, userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================
// LÍMITE DE REGISTRO DE CUENTA OPERATIVA (Bugfix-5F)
// ============================================
// Un evento por cada CuentaOperativa creada exitosamente vía
// POST /api/operativo/register (nunca por email duplicado, validación
// fallida, request inválido, error del servidor, ni límite alcanzado — ver
// src/app/api/operativo/register/route.ts). Nunca guarda la IP ni la cookie
// de dispositivo en texto plano: solo su HMAC-SHA256 con un secreto de
// servidor dedicado (src/lib/operativo-registration-limit.ts). Sin FK hacia
// CuentaOperativa a propósito — es un contador de abuso, no una relación de
// dominio.
//
// ipHash es nullable a propósito (corrección posterior a la versión inicial
// de Bugfix-5F): cuando no puede determinarse una IP fiable, NUNCA se hashea
// el valor "unknown" — eso produciría el mismo hash compartido por todos los
// usuarios sin IP detectable, bloqueando globalmente a cualquiera cuya IP no
// pudiera determinarse después de solo 3 registros ajenos. Con ipHash = null,
// el conteo por IP se omite (nunca se cuenta "cuántos eventos tienen
// ipHash = null") y solo se aplica el límite por dispositivo.
model CuentaOperativaRegistro {
  id         String   @id @default(cuid())
  ipHash     String?
  deviceHash String
  createdAt  DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@map("cuenta_operativa_registros")
}

// ============================================
// PROMOCIONES (cached view of discounted products)
// ============================================
model Promocion {
  id             String    @id @default(cuid())
  productoId     String    @unique
  negocioId      String
  negocioSlug    String
  negocioNombre  String
  precioOriginal Float
  precioPromo    Float
  descuento      String // e.g. "20%" or "$500"
  fechaInicio    DateTime  @default(now())
  fechaFin       DateTime?
  activa         Boolean   @default(true)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  negocio  Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@map("promociones")
}

// ============================================
// MESAS (Salón)
// ============================================
model Mesa {
  id         String    @id @default(cuid())
  numero     Int
  nombre     String    @default("") // "Patio 1", "Barra 3", etc.
  zona       String    @default("") // zone grouping (e.g., "Patio", "Adentro")
  forma      String    @default("") // "redonda", "cuadrada", etc.
  capacidad  Int       @default(4)
  activa     Boolean   @default(true)
  negocioId  String
  negocio    Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  empleadoId String? // Mozo asignado a esta mesa
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)

  // P0-D.1: puntero a la ocupación rotativa activa (nullable — la mayoría del
  // tiempo una mesa no tiene ninguna). @unique impide que la misma ocupación
  // sea "la actual" de más de una mesa a la vez. SetNull porque si la
  // ocupación apuntada se borra, la mesa simplemente vuelve a no tener
  // ocupación actual — nunca debe arrastrar el borrado de la Mesa.
  ocupacionActualId String?               @unique
  ocupacionActual   SesionOcupacionMesa?  @relation("MesaOcupacionActual", fields: [ocupacionActualId], references: [id], onDelete: SetNull)
  // Historial completo de ocupaciones de esta mesa (activas, cerradas y
  // futuras) — relación nombrada distinta de la anterior para que Prisma no
  // las confunda (dos relaciones entre los mismos dos modelos).
  ocupaciones       SesionOcupacionMesa[] @relation("MesaOcupacionHistorial")

  @@unique([negocioId, numero])
  @@map("mesas")
}

// ============================================
// OCUPACIÓN DE MESA (P0-D.1 — fundación)
// ============================================
// Sesión rotativa compartida por todos los clientes de una mesa física,
// entre el momento en que alguien escanea el QR estando "inside" de la
// geocerca (P0-C.2, src/lib/mesa-geofence.ts) y el cierre futuro de la mesa
// (P0-D.3, todavía no implementado). El QR físico y su URL
// (/n/{slug}?mesa={numero}) nunca cambian — lo que rota es esta ocupación.
// Cada dispositivo recibe su propia CredencialOcupacionMesa (token opaco,
// hasheado, nunca guardado en claro — mismo patrón que Sesion.token /
// PasswordResetToken.tokenHash / SesionTerminalOperativa.tokenHash), pero
// todos los dispositivos de la mesa comparten la misma SesionOcupacionMesa
// mientras esté activa.
//
// P0-D.1 SOLO abre o reutiliza la ocupación desde la comprobación pública de
// geocerca. Todavía NO exige ni vincula ningún pedido a ella (eso es
// P0-D.2), y todavía NO implementa cierre manual ni expiración automática
// (eso es P0-D.3) — por eso los campos de cierre son nullable y el estado
// inicial siempre es "activa".
model SesionOcupacionMesa {
  id        String @id @default(cuid())
  negocioId String
  mesaId    String

  // activa | cerrada | expirada — string controlado, mismo patrón sin enum
  // Prisma que ya usa el resto del schema (Pedido.estado,
  // TerminalOperativa.estado, Empleado.areaOperativa, etc.).
  estado String @default("activa")

  iniciadaEn        DateTime @default(now())
  ultimaActividadEn DateTime @default(now())

  // Nullable a propósito: P0-D.1 nunca los escribe — quedan preparados para
  // el cierre real de P0-D.3 (cierre por Mozo/Salón/Negocio o expiración).
  cerradaEn      DateTime?
  cerradaPorTipo String?
  motivoCierre   String?
  cerradaPorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocio      Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  // Relación de historial (muchas ocupaciones por mesa a lo largo del
  // tiempo) — nombrada explícitamente distinta de "MesaOcupacionActual"
  // (el puntero 1:1 en Mesa.ocupacionActualId) para que Prisma no confunda
  // las dos relaciones entre los mismos dos modelos. Cascade: una ocupación
  // no tiene identidad propia sin su mesa.
  mesa         Mesa    @relation("MesaOcupacionHistorial", fields: [mesaId], references: [id], onDelete: Cascade)
  // Lado inverso del puntero "actual" de Mesa — sin fields/references acá,
  // vive en Mesa.ocupacionActualId.
  mesaActualDe Mesa?   @relation("MesaOcupacionActual")

  credenciales CredencialOcupacionMesa[]
  pedidos      Pedido[]

  // P0-D.1A: además de estos índices, la migración versionada
  // (prisma/migrations/20260804000000_add_table_occupancy_sessions) agrega el
  // índice único PARCIAL "sesiones_ocupacion_mesa_mesaId_activa_key" sobre
  // ("mesaId") WHERE estado = 'activa' — la garantía real de "máximo una
  // ocupación activa por mesa" vive ahí, no en Mesa.ocupacionActualId
  // @unique (que solo impide que la misma ocupación sea "la actual" de más
  // de una mesa). Prisma no soporta índices únicos parciales en su DSL
  // (ninguna versión actual, incluida 6.19.2), así que este índice no puede
  // declararse acá — solo existe en el SQL. Deuda: un futuro "db pull" o una
  // migración autogenerada deben preservarlo manualmente.
  @@index([negocioId, estado])
  @@index([mesaId, estado])
  @@index([ultimaActividadEn])
  @@map("sesiones_ocupacion_mesa")
}

// Autorización opaca de UN dispositivo/navegador para UNA ocupación
// concreta. Nunca representa una cuenta de usuario — no tiene nombre, email
// ni teléfono. Una ocupación puede tener varias credenciales (una por
// dispositivo); una credencial pertenece a una sola ocupación.
model CredencialOcupacionMesa {
  id          String @id @default(cuid())
  ocupacionId String

  // Solo se guarda el hash SHA-256 del token real — el token en claro vive
  // únicamente en la cookie HttpOnly del dispositivo, nunca en la base.
  tokenHash String @unique

  emitidaEn         DateTime  @default(now())
  ultimaActividadEn DateTime  @default(now())
  revocadaEn        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: una credencial no tiene ningún significado fuera de su
  // ocupación (mismo patrón que SesionTerminalOperativa → TerminalOperativa).
  ocupacion SesionOcupacionMesa @relation(fields: [ocupacionId], references: [id], onDelete: Cascade)

  @@index([ocupacionId])
  @@map("credenciales_ocupacion_mesa")
}

// ============================================
// EMPLEADOS (Mozos / Personal)
// ============================================
model CuentaOperativa {
  id            String    @id @default(cuid())
  nombre        String
  email         String    @unique
  password      String?
  googleId      String?   @unique
  telefono      String?
  emailVerified DateTime?
  activo        Boolean   @default(true)
  eliminado     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empleados     Empleado[]
  codigosUsados CodigoIncorporacionMozo[]

  @@index([activo, eliminado])
  @@map("cuentas_operativas")
}

model Empleado {
  id               String  @id @default(cuid())
  nombre           String
  codigo           String // código corto para identificar al mozo
  rol              String  @default("mozo") // mozo, cajero, cocinero, admin
  permisos         String  @default("[]") // JSON array: ["gestion_pedidos", "gestion_productos", "gestion_caja", "gestion_empleados"]
  // Área operativa para la futura PWA DeliGO Operaciones. La administra el negocio;
  // el empleado NO puede cambiarla. No reemplaza a `rol`. Valores: sin_asignar|mozo|salon|pyr.
  areaOperativa     String  @default("sin_asignar")
  // Se incrementa cada vez que cambia `areaOperativa` para que la PWA detecte el nuevo contexto.
  asignacionVersion Int     @default(1)
  activo           Boolean @default(true)
  eliminado        Boolean @default(false)
  token            String? // token para notificaciones push
  pushSubscription String? // push subscription JSON for browser notifications
  negocioId        String
  negocio          Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cuentaOperativaId String?
  cuentaOperativa   CuentaOperativa? @relation(fields: [cuentaOperativaId], references: [id], onDelete: SetNull)
  mesas            Mesa[] // Mesas asignadas a este mozo
  codigosIncorporacionObjetivo CodigoIncorporacionMozo[]

  @@unique([negocioId, codigo])
  @@unique([negocioId, cuentaOperativaId])
  @@index([cuentaOperativaId])
  @@map("empleados")
}

model CodigoIncorporacionMozo {
  id                        String   @id @default(cuid())
  negocioId                 String
  empleadoObjetivoId        String?
  rol                       String   @default("mozo")
  codeHash                  String   @unique
  codePrefix                String   @default("")
  expiresAt                 DateTime
  // Consumo futuro: transaccion atomica solo si usedAt es null,
  // revokedAt es null y expiresAt sigue vigente.
  usedAt                    DateTime?
  usedByCuentaOperativaId   String?
  revokedAt                 DateTime?
  createdAt                 DateTime @default(now())

  negocio                 Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  empleadoObjetivo        Empleado? @relation(fields: [empleadoObjetivoId], references: [id], onDelete: SetNull)
  usedByCuentaOperativa   CuentaOperativa? @relation(fields: [usedByCuentaOperativaId], references: [id], onDelete: SetNull)

  @@index([negocioId, expiresAt])
  @@index([negocioId, revokedAt])
  @@index([empleadoObjetivoId])
  @@index([usedByCuentaOperativaId])
  @@index([rol])
  @@map("codigos_incorporacion_mozo")
}

// Terminal compartida de Operaciones (PC caja, tablet cocina, tablet atención, monitor,
// celular compartido). Tabla física conservada: "terminales_salon" (renombre solo lógico).
// Autorización futura (NO implementada aún):
//   - `areas` + `scopes` son la fuente de verdad. Áreas: salon | pyr (nunca mozo).
//   - Scopes salón: salon.ver, salon.pedidos.ver, salon.pedidos.cambiar_estado,
//       salon.pedidos.marcar_entregado, salon.mesas.liberar, salon.mesas.reasignar,
//       salon.historial.ver, salon.estadisticas.ver
//   - Scopes PyR: pyr.ver, pyr.pedidos.ver, pyr.pedidos.gestionar, pyr.resenas.ver,
//       pyr.resenas.responder, pyr.mensajes.ver, pyr.mensajes.responder
//   - `perfil` es solo una etiqueta/preset para la UI.
//   - Una terminal NUNCA recibe permisos de administrador ni de delivery de repartidores.
model TerminalOperativa {
  id               String    @id @default(cuid())
  negocioId        String
  nombre           String    @default("Terminal Operativa") // nombre visible del dispositivo
  estado           String    @default("pendiente") // pendiente|activo|revocado; la revocación efectiva se hace vía revokedAt
  perfil           String    @default("pantalla") // etiqueta/preset para UI (no autoriza por sí solo)
  areas            String    @default("[]") // JSON array — áreas permitidas (salon|pyr); fuente de verdad
  scopes           String    @default("[]") // JSON array — fuente de verdad de autorización (deny-by-default)
  pushSubscription String?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  negocio       Negocio                        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  sesiones      SesionTerminalOperativa[]
  vinculaciones VinculacionTerminalOperativa[]

  @@index([negocioId, estado])
  @@index([negocioId, revokedAt])
  @@index([lastUsedAt])
  @@map("terminales_salon")
}

model VinculacionTerminalOperativa {
  id        String   @id @default(cuid())
  negocioId String
  terminalSalonId String? // columna física conservada ("terminalSalonId"); emparejamiento → terminal
  codeHash  String   @unique
  codePrefix String  @default("")
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  negocio           Negocio            @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  terminalOperativa TerminalOperativa? @relation(fields: [terminalSalonId], references: [id], onDelete: Cascade)

  @@index([negocioId, expiresAt])
  @@index([negocioId, revokedAt])
  @@index([usedAt])
  @@index([terminalSalonId])
  @@map("vinculaciones_terminal_salon")
}

model SesionTerminalOperativa {
  id              String   @id @default(cuid())
  terminalSalonId String   // columna física conservada ("terminalSalonId")
  tokenHash       String   @unique
  expiresAt       DateTime
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  terminalOperativa TerminalOperativa @relation(fields: [terminalSalonId], references: [id], onDelete: Cascade)

  @@index([terminalSalonId, revokedAt])
  @@index([expiresAt])
  @@index([lastUsedAt])
  @@map("sesiones_terminal_salon")
}

// ============================================
// CONFIG PLATAFORMA
// ============================================
model ConfigPlataforma {
  id                   String   @id @default(cuid())
  clave                String   @unique @default("")
  valor                String   @default("")
  promocionadosActivos Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@map("config_plataforma")
}

// ============================================
// OPCIONES COMPARTIDAS
// ============================================
model OpcionesCompartidas {
  id          String   @id @default(cuid())
  nombre      String
  opciones    String   @default("[]") // JSON array of options
  obligatorio Boolean  @default(false)
  maximo      Int      @default(0)
  negocioId   String
  negocio     Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("opciones_compartidas")
}

// ============================================
// DENUNCIAS (Customer Reports)
// ============================================
model Denuncia {
  id            String   @id @default(cuid())
  // 19-B0.2C: nullable únicamente para preservar el expediente cuando la
  // cuenta del Cliente denunciado se elimina — la creación de una Denuncia
  // nueva sigue exigiendo un Cliente real (POST /api/denuncias valida esto
  // en la aplicación, no en el schema).
  clienteId     String?
  negocioId     String
  pedidoId      String? // optional: linked order
  negocioNombre String // denormalized for quick display
  clienteNombre String // denormalized
  motivoTipo    String   @default("otro") // "direccion_falsa", "no_retiro", "no_pago", "comportamiento", "otro"
  motivo        String // reason text (preset label or custom)
  fecha         DateTime @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  negocio Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([negocioId])
  @@map("denuncias")
}

// ============================================
// CLIENTES BLOQUEADOS (IP/Device tracking)
// ============================================
model ClienteBloqueado {
  id            String   @id @default(cuid())
  ip            String
  fingerprint   String   @default("")
  clienteId     String? // may be null if just IP block
  clienteNombre String   @default("")
  fecha         DateTime @default(now())

  @@index([ip])
  @@index([fingerprint])
  @@map("clientes_bloqueados")
}

// ============================================
// AUDITORÍA DE ACCIONES
// ============================================
model AuditLog {
  id        String   @id @default(cuid())
  userId    String // who
  userType  String // cliente, negocio, repartidor, superadmin, empleado
  accion    String // what: e.g. "producto.creado", "producto.eliminado", "pedido.estado_cambiado", "negocio.suspendido"
  recurso   String // e.g. "producto", "pedido", "empleado"
  recursoId String   @default("") // ID of the affected resource
  detalle   String   @default("{}") // JSON with additional context (before/after values, etc.)
  ip        String   @default("")
  fecha     DateTime @default(now())

  @@index([userId, fecha])
  @@index([recurso, recursoId])
  @@index([accion])
  @@map("audit_logs")
}

// ============================================
// NOTIFICACIONES (In-app + Push)
// ============================================
model Notificacion {
  id        String   @id @default(cuid())
  userId    String // ID del destinatario
  userType  String // cliente, negocio, repartidor, superadmin, empleado
  tipo      String // order_update, new_order, new_delivery, review, chat, review_request, account_update
  titulo    String // notification title
  cuerpo    String // notification body text
  leido     Boolean  @default(false)
  pedidoId  String? // related order ID (for navigation)
  negocioId String? // related business ID
  datos     String   @default("{}") // JSON: additional data for navigation/action
  createdAt DateTime @default(now())

  @@index([userId, userType, leido, createdAt])
  @@index([userId, userType, createdAt])
  @@map("notificaciones")
}

// ============================================
// HISTORIAL DE PEDIDOS (Eventos)
// ============================================
model PedidoEvento {
  id             String   @id @default(cuid())
  pedidoId       String
  estado         String // recibido, preparando, en_camino, listo_para_retirar, entregado, cancelado
  estadoAnterior String   @default("") // previous state
  userId         String? // who triggered the change
  userType       String? // cliente, negocio, repartidor, superadmin, empleado
  nota           String   @default("") // optional note (e.g. cancellation reason)
  fecha          DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, fecha])
  @@map("pedido_eventos")
}

// ============================================
// SOLICITUDES DESTACADO
// ============================================
model DestacadoSolicitud {
  id        String  @id @default(cuid())
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  // Período solicitado
  meses Int @default(0)
  dias  Int @default(0)

  // Precio calculado
  precio Float

  // Estado: pendiente, aprobada, rechazada
  estado String @default("pendiente")

  // Comprobante
  comprobanteUrl String?

  // Nota del admin al rechazar
  notaAdmin String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt])
  @@index([negocioId])
  @@map("destacado_solicitudes")
}
