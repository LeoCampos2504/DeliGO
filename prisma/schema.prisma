  // P2-T56-R3A-I1: ON | DRAINING | OFF (A0.1-9). Default OFF = comportamiento
  // actual sin reservas. Ningún runtime lo lee ni lo cambia en I1.
  stockReservaModo     String   @default("OFF")
  updatedAt            DateTime @updatedAt

  @@map("config_plataforma")
