// ============================================
// AUDITORÍA DE ACCIONES
// ============================================
model AuditLog {
  id        String   @id @default(cuid())
  userId    String // who
  userType  String // cliente, negocio, repartidor, superadmin, empleado
  accion    String // what: e.g. "producto.creado", "producto.eliminado", "pedido.estado_cambiado", "negocio.suspendido"
  recurso   String // e.g. "producto", "pedido", "empleado"
  recursoId String   @default("") // ID of the affected resource
  detalle   String   @default("{}") // JSON with additional context (before/after values, etc.)
  ip        String   @default("")
  fecha     DateTime @default(now())

  @@index([userId, fecha])
  @@index([recurso, recursoId])
  @@index([accion])
  @@map("audit_logs")
}

// ============================================
// EVIDENCIA DE ACEPTACIÓN DE TÉRMINOS Y PRIVACIDAD
// ============================================
// Append-only: nunca se actualiza ni sobreescribe una fila existente. Una
// reaceptación futura (ej. tras un cambio material de Términos) crea una
// fila NUEVA — se conserva el historial completo, nunca se pierde evidencia
// anterior. userId/userType son polimórficos sin relación FK, mismo patrón
// que AuditLog — el sujeto puede ser un Cliente, Negocio o Repartidor.
model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String // who
  userType       String // cliente, negocio, repartidor
  termsVersion   String // ver src/lib/legal-versions.ts — nunca confiado del cliente
  privacyVersion String // ver src/lib/legal-versions.ts — nunca confiado del cliente
  source         String // flujo donde ocurrió: "register" hoy
  acceptedAt     DateTime @default(now()) // server-side siempre; nunca desde el cliente

  @@index([userId, userType])
  @@map("legal_acceptances")
}

// ============================================
// NOTIFICACIONES (In-app + Push)
// ============================================
model Notificacion {
  id        String   @id @default(cuid())
  userId    String // ID del destinatario
  userType  String // cliente, negocio, repartidor, superadmin, empleado
  tipo      String // order_update, new_order, new_delivery, review, chat, review_request, account_update
  titulo    String // notification title
  cuerpo    String // notification body text
  leido     Boolean  @default(false)
  pedidoId  String? // related order ID (for navigation)
  negocioId String? // related business ID
  // 19-B0.2E1: provenance estructurada — identifica al Cliente cuyos datos
  // (nombre/dirección/texto de chat) pueden estar embebidos en titulo/cuerpo
  // cuando el DESTINATARIO (userId/userType) es OTRO actor (Negocio/Repartidor).
  // NUNCA representa al destinatario ni lo reemplaza. Sin FK: la limpieza al
  // eliminar la cuenta del Cliente la gestiona la aplicación (sanitiza el
  // contenido y luego nulifica este campo en la misma transacción), no un
  // `onDelete` de base de datos — evitar un SetNull automático que borre la
  // provenance antes de poder sanitizar el contenido embebido.
  sourceClienteId String?
  datos     String   @default("{}") // JSON: additional data for navigation/action
  createdAt DateTime @default(now())

  @@index([userId, userType, leido, createdAt])
  @@index([userId, userType, createdAt])
  @@index([sourceClienteId])
  @@map("notificaciones")
}

// P2-T05 (F-P0-03): tabla normalizada de subscriptions push multi-dispositivo
// real, reemplazo gradual de los campos legacy `pushSubscription` de un solo
// valor por actor (ver Cliente/Negocio/Repartidor/Empleado). Owner polimorfico
// SIN FK, mismo patron que Notificacion.userId/userType arriba — la limpieza
// al eliminar/desactivar un actor la gestiona la aplicacion, nunca un
// onDelete de DB. `channel` distingue el push personal ("default") del canal
// compartido de Salon en Negocio ("salon", espejo de
// Negocio.pushSubscriptionSalon) para que ninguno oculte al otro durante el
// fallback de lectura del rollout.
//
// P2-T05 Stage1C (F-P2-T05-03, reconciliacion con P0 invariante I4): el
// endpoint/keys del body NUNCA es prueba de posesion (P0 ya lo establecio al
// rechazar el "Modelo D" de transferencia de propiedad) — por eso el UNIQUE
// de abajo es exclusivamente (ownerType, ownerId, channel, endpoint):
// garantiza la idempotencia del PROPIO owner re-suscribiendose, pero
// deliberadamente nunca impide que dos owners distintos compartan el mismo
// endpoint fisico (multi-bind tolerado, el mismo estado que P0 ya aceptaba).
// Ningun primitive sobre esta tabla puede borrar la fila de un owner
// distinto al que la solicita — ver src/lib/push-subscription-repository.ts.
enum PushSubscriptionOwnerType {
  cliente
  negocio
  repartidor
  empleado
  cuenta_operativa
  // P2-T39-R3: owner moderno para Web Push de SuperAdmin. El campo legacy
  // SuperAdmin.pushSubscription queda inerte (P2-T17) — deliberadamente no se
  // le hace dual-write ni se lo une como legacyRaw en resolveCorePushTargets.
  superadmin
}

enum PushSubscriptionChannel {
  default
  salon
}

model PushSubscription {
  id             String                    @id @default(cuid())
  ownerType      PushSubscriptionOwnerType
  ownerId        String
  channel        PushSubscriptionChannel   @default(default)
  endpoint       String
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([ownerType, ownerId, channel, endpoint])
  @@index([ownerType, ownerId, channel])
  @@index([endpoint])
  @@map("push_subscriptions")
}

// ============================================
// HISTORIAL DE PEDIDOS (Eventos)
// ============================================
model PedidoEvento {
  id             String   @id @default(cuid())
  pedidoId       String
  estado         String // recibido, preparando, en_camino, listo_para_retirar, entregado, cancelado
  estadoAnterior String   @default("") // previous state
  userId         String? // who triggered the change
  userType       String? // cliente, negocio, repartidor, superadmin, empleado
  nota           String   @default("") // optional note (e.g. cancellation reason)
  fecha          DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, fecha])
  @@map("pedido_eventos")
}

// ============================================
// SOLICITUDES DESTACADO
// ============================================
model DestacadoSolicitud {
  id        String  @id @default(cuid())
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  // Período solicitado
  meses Int @default(0)
  dias  Int @default(0)

  // Precio calculado
  precio Float

  // Estado: pendiente, aprobada, rechazada
  estado String @default("pendiente")

  // Comprobante
  comprobanteUrl String?

  // Nota del admin al rechazar
  notaAdmin String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt])
  @@index([negocioId])
  @@map("destacado_solicitudes")
}

// F5 / F10-C2b — qué productos y variantes entrega cada proveedor (muchos a muchos). Sólo configuración:
// no mueve stock, costos, deuda ni dinero. Unicidad parcial (producto sin variante / variante) y guarda de
// negocio en SQL (migración 20261120120000_f5_supplier_products).
model ProveedorProducto {
  id                 String   @id @default(cuid())
  negocioId          String
  proveedorId        String
  productoId         String
  productoVarianteId String?
  origen             String // MANUAL | RECEPCION
  createdAt          DateTime @default(now())

  negocio          Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  proveedor        Proveedor         @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: Cascade)

  @@index([negocioId, proveedorId])
  @@index([productoId])
  @@map("proveedor_productos")
}

// F10-C2b / D-7 v2 — salida PAGO_PROVEEDOR de Caja hecha AL RECIBIR, asociada a su recepción (no mueve dinero).
// Al aprobar: crédito F5 (si no lo había) + aplicación automática a la deuda; el excedente queda como anticipo.
// Guardas SQL en la migración 20261120150000_c2b_reception_payments.
model PagoRecepcion {
  id                     String   @id @default(cuid())
  negocioId              String
  recepcionId            String
  proveedorId            String
  egresoCajaId           String
  origen                 String // CAJERO_AL_RECIBIR | ASOCIADO_DUENO
  estado                 String   @default("PENDIENTE") // PENDIENTE | OBSERVADO | ACREDITADO
  creditoProveedorId     String?
  importeAplicadoDecimal Decimal? @db.Decimal(12, 2)
  observacion            String?
  actorTipo              String
  actorId                String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  negocio   Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  recepcion Recepcion         @relation(fields: [recepcionId, negocioId], references: [id, negocioId], onDelete: Cascade)
  proveedor Proveedor         @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  egreso    EgresoCaja        @relation(fields: [egresoCajaId, negocioId], references: [id, negocioId], onDelete: NoAction)
  credito   CreditoProveedor? @relation(fields: [creditoProveedorId, proveedorId, negocioId], references: [id, proveedorId, negocioId], onDelete: NoAction)

  @@unique([negocioId, egresoCajaId])
  @@index([negocioId, recepcionId])
  @@map("pagos_recepcion")
}

// F10-C2b — historial de precios de venta actualizados (opcionalmente) al aprobar una recepción. Append-only.
model CambioPrecioVenta {
  id                    String   @id @default(cuid())
  negocioId             String
  productoId            String
  productoVarianteId    String?
  recepcionId           String
  recepcionLineaId      String
  precioAnteriorDecimal Decimal  @db.Decimal(12, 2)
  precioNuevoDecimal    Decimal  @db.Decimal(12, 2)
  costoAnteriorDecimal  Decimal  @db.Decimal(14, 4)
  costoNuevoDecimal     Decimal  @db.Decimal(14, 4)
  recargoPctDecimal     Decimal  @db.Decimal(12, 4)
  origen                String   @default("APROBACION_RECEPCION")
  actorTipo             String
  actorId               String
  createdAt             DateTime @default(now())

  negocio          Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  recepcion        Recepcion         @relation(fields: [recepcionId, negocioId], references: [id, negocioId], onDelete: Cascade)
  recepcionLinea   RecepcionLinea    @relation(fields: [recepcionLineaId], references: [id], onDelete: Cascade)
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: Cascade)
  etiqueta         EtiquetaPrecio? // F10-C2c

  @@index([negocioId, productoId])
  @@map("cambios_precio_venta")
}

// F10-C2c — precio autorizado por el dueño que espera el cambio de la etiqueta de góndola. PENDIENTE hasta que un
// empleado (o el dueño) confirma la etiqueta → ACTIVADA (recién ahí cambia el precio de venta). Una autorización más
// nueva del mismo producto/variante la deja REEMPLAZADA; nunca se activa un precio viejo. Inmutable una vez resuelta.
model EtiquetaPrecio {
  id                    String    @id @default(cuid())
  negocioId             String
  productoId            String
  productoVarianteId    String?
  cambioPrecioVentaId   String    @unique
  precioAnteriorDecimal Decimal   @db.Decimal(12, 2) // precio de venta activo al autorizar
  precioNuevoDecimal    Decimal   @db.Decimal(12, 2) // precio autorizado por el dueño
  modo                  String // ETIQUETA | SIN_ETIQUETA
  estado                String    @default("PENDIENTE") // PENDIENTE | ACTIVADA | REEMPLAZADA | DESCARTADA
  reemplazaAId          String?   @unique
  autorizadaPorTipo     String
  autorizadaPorId       String
  autorizadaEn          DateTime  @default(now())
  resolucion            String?
  resueltaEn            DateTime?
  resueltaPorTipo       String?
  resueltaPorId         String?

  negocio           Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto          Producto               @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoVariante  ProductoVariante?      @relation(fields: [productoVarianteId], references: [id], onDelete: Cascade)
  cambioPrecioVenta CambioPrecioVenta      @relation(fields: [cambioPrecioVentaId], references: [id], onDelete: Cascade)
  activacion        ActivacionPrecioVenta?

  @@index([negocioId, estado])
  @@map("etiquetas_precio")
}

// F10-C2c — cada cambio EFECTIVO del precio de venta (append-only): por etiqueta confirmada, activación del dueño o
// edición desde el catálogo. Es la base para cobrar a una venta ya iniciada el precio vigente cuando empezó.
model ActivacionPrecioVenta {
  id                    String   @id @default(cuid())
  negocioId             String
  productoId            String
  productoVarianteId    String?
  precioAnteriorDecimal Decimal  @db.Decimal(12, 2)
  precioNuevoDecimal    Decimal  @db.Decimal(12, 2)
  origen                String // ETIQUETA | DUENO_SIN_ETIQUETA | APROBACION_SIN_ETIQUETA | CATALOGO
  etiquetaPrecioId      String?  @unique
  actorTipo             String
  actorId               String
  activadoEn            DateTime @default(now())

  negocio          Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: Cascade)
  etiquetaPrecio   EtiquetaPrecio?   @relation(fields: [etiquetaPrecioId], references: [id], onDelete: Cascade)

  @@index([negocioId, productoId, activadoEn])
  @@map("activaciones_precio_venta")
}

// F10-C2c — inicio de una venta de Caja: el servidor fija la hora; al cobrar se respetan los precios vigentes en ese
// momento (también para productos agregados después). Un solo uso, vence a los 30 minutos.
model InicioVenta {
  id         String    @id @default(cuid())
  negocioId  String
  actorTipo  String // NEGOCIO | EMPLEADO
  actorId    String
  iniciadaEn DateTime  @default(now())
  expiraEn   DateTime
  ventaId    String?   @unique
  usadaEn    DateTime?

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  venta   Venta?  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([negocioId, iniciadaEn])
  @@map("inicios_venta")
}

// Catálogo — importación masiva de productos desde Excel/CSV. Un registro por confirmación (clave idempotente del
// navegador): reintentos, doble clic o cortes devuelven el mismo resultado y nunca duplican productos. `resultados`
// guarda el resultado de cada grupo de filas en la MISMA transacción que su escritura (una sola vez por grupo);
// `bloqueadaHasta` es el turno de procesamiento (si el proceso se corta, otro intento retoma lo que faltó).
model ImportacionProductos {
  id             String    @id @default(cuid())
  negocioId      String
  clave          String
  huella         String
  actorTipo      String // NEGOCIO | EMPLEADO
  actorId        String
  archivo        String    @default("")
  estado         String    @default("EN_CURSO") // EN_CURSO | COMPLETADA
  totalGrupos    Int       @default(0)
  resultados     Json      @default("{}")
  resumen        Json?
  bloqueadaHasta DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, clave])
  @@index([negocioId, createdAt])
  @@map("importaciones_productos")
}

// ============================================
// T7-F1 — RETIROS PERSONALES DE MERCADERÍA DESDE CAJA
// ============================================
// Diseño: codex-reports/T7_F1_RETIROS_PERSONALES_DISENO.md. Una salida NO comercial de mercadería: nunca es una
// Venta, un cobro, una operación ni un movimiento financiero. El stock lo mueve sólo la autoridad (stock-lifecycle.ts)
// con movimientos RETIRO_PERSONAL / RETIRO_PERSONAL_REINGRESO. Valores congelados al registrar (precio de venta de
// Caja y costo conocido; costo NULL = desconocido, nunca 0). Invariantes en SQL: migración 20261127200000.

/// Familiar frecuente del negocio (no necesita cuenta de DeliGO). Único por nombre normalizado.
model FamiliarRetiro {
  id                String   @id @default(cuid())
  negocioId         String
  nombre            String
  nombreNormalizado String
  activo            Boolean  @default(true)
  creadoPorTipo     String // NEGOCIO | EMPLEADO
  creadoPorId       String
  createdAt         DateTime @default(now())

  negocio Negocio          @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  retiros RetiroPersonal[]

  @@unique([negocioId, nombreNormalizado])
  @@map("familiares_retiro")
}

model RetiroPersonal {
  id                       String   @id @default(cuid())
  negocioId                String
  beneficiarioTipo         String // EMPLEADO | FAMILIAR | DUENO
  beneficiarioEmpleadoId   String?
  beneficiarioFamiliarId   String?
  beneficiarioNombre       String // nombre histórico
  registradoPorTipo        String // NEGOCIO | EMPLEADO
  registradoPorEmpleadoId  String?
  registradoPorNombre      String // nombre histórico de quien registró
  turnoCajaId              String? // turno ABIERTO del cajero al registrar (contexto; sin efecto en el efectivo)
  valorComercialDecimal    Decimal  @db.Decimal(12, 2)
  costoConocidoDecimal     Decimal  @db.Decimal(12, 2)
  costoCompleto            Boolean
  cantidadLineas           Int
  observaciones            String?
  estado                   String   @default("VIGENTE") // VIGENTE | ANULADO
  idempotencyKey           String
  idempotencyFingerprint   String
  createdAt                DateTime @default(now())

  negocio           Negocio                   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  beneficiarioEmpleado Empleado?              @relation("RetiroBeneficiarioEmpleado", fields: [beneficiarioEmpleadoId], references: [id], onDelete: NoAction)
  beneficiarioFamiliar FamiliarRetiro?        @relation(fields: [beneficiarioFamiliarId], references: [id], onDelete: NoAction)
  registradoPorEmpleado Empleado?             @relation("RetiroRegistradoPorEmpleado", fields: [registradoPorEmpleadoId], references: [id], onDelete: NoAction)
  turnoCaja         TurnoCaja?                @relation(fields: [turnoCajaId], references: [id], onDelete: NoAction)
  lineas            RetiroPersonalLinea[]
  movimientos       MovimientoInventario[]
  devoluciones      DevolucionRetiroPersonal[]
  decisionItems     DecisionRecuperoRetiroItem[]

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, createdAt])
  @@index([negocioId, beneficiarioTipo, createdAt])
  @@index([beneficiarioEmpleadoId])
  @@index([beneficiarioFamiliarId])
  @@map("retiros_personales")
}

/// Snapshot inmutable por línea (mismo principio que VentaItem).
model RetiroPersonalLinea {
  id                    String   @id @default(cuid())
  negocioId             String
  retiroId              String
  orden                 Int
  productoId            String?
  productoVarianteId    String?
  nombre                String
  varianteNombre        String?
  cantidad              Float
  precioUnitarioDecimal Decimal  @db.Decimal(12, 2)
  valorLineaDecimal     Decimal  @db.Decimal(12, 2) // valor comercial de la línea (precio × cantidad); NO es un importe de venta
  costoUnitarioDecimal  Decimal? @db.Decimal(14, 4) // NULL = costo desconocido (nunca 0)
  costoTotalDecimal     Decimal? @db.Decimal(12, 2)
  movioStock            Boolean // la clave tenía control de stock y se descontó en el retiro

  negocio          Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  retiro           RetiroPersonal          @relation(fields: [retiroId], references: [id], onDelete: Cascade)
  producto         Producto?               @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoVariante ProductoVariante?       @relation(fields: [productoVarianteId], references: [id], onDelete: SetNull)
  devoluciones     DevolucionRetiroLinea[]

  @@unique([retiroId, orden])
  @@map("retiro_personal_lineas")
}

/// Anulación por error de registro o devolución física: nunca borra el retiro original.
model DevolucionRetiroPersonal {
  id                   String   @id @default(cuid())
  negocioId            String
  retiroId             String
  tipo                 String // ANULACION | DEVOLUCION
  motivo               String
  registradoPorNombre  String
  valorDecimal         Decimal  @db.Decimal(12, 2)
  costoConocidoDecimal Decimal  @db.Decimal(12, 2)
  idempotencyKey       String
  idempotencyFingerprint String
  createdAt            DateTime @default(now())

  negocio     Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  retiro      RetiroPersonal          @relation(fields: [retiroId], references: [id], onDelete: Cascade)
  lineas      DevolucionRetiroLinea[]
  movimientos MovimientoInventario[]

  @@unique([negocioId, idempotencyKey])
  @@index([retiroId])
  @@map("devoluciones_retiro")
}

model DevolucionRetiroLinea {
  id                 String   @id @default(cuid())
  negocioId          String
  devolucionId       String
  retiroLineaId      String
  cantidad           Float
  valorDecimal       Decimal  @db.Decimal(12, 2)
  costoDecimal       Decimal? @db.Decimal(12, 2)
  reingresoStock     Boolean

  negocio     Negocio                  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  devolucion  DevolucionRetiroPersonal @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  retiroLinea RetiroPersonalLinea      @relation(fields: [retiroLineaId], references: [id], onDelete: Cascade)

  @@unique([devolucionId, retiroLineaId])
  @@index([retiroLineaId])
  @@map("devolucion_retiro_lineas")
}

/// Decisión INFORMATIVA del dueño sobre retiros de un empleado (no es un cobro ni un descuento de sueldo).
model DecisionRecuperoRetiro {
  id                    String   @id @default(cuid())
  negocioId             String
  empleadoId            String
  importeRecuperarDecimal Decimal @db.Decimal(12, 2)
  valorElegibleDecimal  Decimal  @db.Decimal(12, 2)
  motivo                String?
  decididoPorNombre     String
  estado                String   @default("VIGENTE") // VIGENTE | REEMPLAZADA | ANULADA
  reemplazaDecisionId   String?
  finalizadaEn          DateTime?
  createdAt             DateTime @default(now())

  negocio   Negocio                      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  empleado  Empleado                     @relation(fields: [empleadoId], references: [id], onDelete: NoAction)
  reemplaza DecisionRecuperoRetiro?      @relation("DecisionReemplazo", fields: [reemplazaDecisionId], references: [id], onDelete: NoAction)
  reemplazadaPor DecisionRecuperoRetiro[] @relation("DecisionReemplazo")
  items     DecisionRecuperoRetiroItem[]

  @@index([negocioId, empleadoId, createdAt])
  @@map("decisiones_recupero_retiro")
}

model DecisionRecuperoRetiroItem {
  id                       String  @id @default(cuid())
  negocioId                String
  decisionId               String
  retiroId                 String
  vigente                  Boolean @default(true)
  elegibleAlDecidirDecimal Decimal @db.Decimal(12, 2)
  asignadoDecimal          Decimal @db.Decimal(12, 2)

  negocio  Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  decision DecisionRecuperoRetiro @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  retiro   RetiroPersonal         @relation(fields: [retiroId], references: [id], onDelete: Cascade)

  @@unique([decisionId, retiroId])
  @@index([retiroId])
  @@map("decision_recupero_retiro_items")
}
