// DeliGO - Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CLIENTES
// ============================================
model Cliente {
  id               String   @id @default(cuid())
  nombre           String
  email            String   @unique
  password         String?
  googleId         String?  @unique
  telefono         String   @default("")
  pushSubscription String?
  fechaRegistro    DateTime @default(now())

  // Email verification
  emailVerified              DateTime?
  verificationToken         String?   @unique
  verificationTokenExpiresAt DateTime?

  // Protección contra clientes maliciosos
  bloqueado              Boolean   @default(false)
  bloqueadoFecha         DateTime?
  ultimoIp               String    @default("")
  dispositivoFingerprint String    @default("")

  direcciones  Direccion[]
  favoritos    Favorito[]
  pedidos      Pedido[]
  resenas      Resena[]
  chatMensajes ChatMensaje[]
  denuncias    Denuncia[]

  @@map("clientes")
}

model Direccion {
  id         String  @id @default(cuid())
  alias      String
  direccion  String
  referencia String  @default("")
  lat        Float?
  lng        Float?
  clienteId  String
  cliente    Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("direcciones")
}

model Favorito {
  id        String  @id @default(cuid())
  clienteId String
  negocioId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([clienteId, negocioId])
  @@map("favoritos")
}

// ============================================
// NEGOCIOS
// ============================================
model Negocio {
  id         String  @id @default(cuid())
  slug       String  @unique
  nombre     String  @unique
  usuario    String  @unique
  email      String  @unique @default("pending@deligo.app")
  password   String
  rubro      String  @default("restaurante") // restaurante, ropa, otro
  aprobado   Boolean @default(false)
  suspendido Boolean @default(false)

  // Email verification
  emailVerified              DateTime?
  verificationToken         String?   @unique
  verificationTokenExpiresAt DateTime?

  // Personalización visual
  colorPrincipal    String  @default("#FB8C00")
  mensajeBienvenida String  @default("")
  logoEnCirculo     Boolean @default(false)
  colorCirculoLogo  String  @default("")
  colorFondo        String  @default("")

  // Categorías de productos
  categorias String @default("[]") // JSON array of strings

  // Categorías de agregados e ingredientes
  agregadosCategorias    String @default("[]") // JSON array of strings
  ingredientesCategorias String @default("[]") // JSON array of strings

  // Secciones del catálogo
  seccionesCatalogo String @default("[]") // JSON array of section objects

  // Horarios (JSON: keys "1"-"7" with apertura/cierre/turno2 etc.)
  horarios      String  @default("{}")
  timezone      String  @default("America/Argentina/Buenos_Aires")
  horarioMode   String  @default("experto") // "simple" = toggle manual, "experto" = horarios por día
  abiertoManual Boolean @default(true) // solo aplica cuando horarioMode = "simple"

  // Redes sociales
  whatsapp  String @default("")
  instagram String @default("")
  facebook  String @default("")

  // Imágenes
  logoUrl        String?
  bannerUrl      String?
  fondoImagenUrl String?

  // Delivery
  ofreceDelivery        Boolean @default(false)
  // T20-DK1 (Dark Kitchen): capacidad de Retiro independiente de Delivery —
  // default true conserva EXACTAMENTE el comportamiento de todos los
  // negocios existentes (retiro estaba siempre disponible antes de este
  // campo). false + ofreceDelivery=true habilita la modalidad "solo delivery".
  ofreceRetiro          Boolean @default(true)
  zonaDeliveryActiva    Boolean @default(false)
  zonasDelivery         String  @default("[]") // JSON array of zone objects
  precioDelivery        Float   @default(0)
  precioDeliveryDefault Float   @default(0)
  deliveryMode          String  @default("") // modo de delivery

  // Ubicación del negocio
  lat Float?
  lng Float?
  // P0-B: marca que `lat`/`lng` fueron confirmados explícitamente por el
  // Negocio (acción "Confirmar ubicación del local"), no solo que existen —
  // las coordenadas pueden venir de otro flujo (p. ej. delivery) sin haber
  // sido calibradas para validar pedidos de mesa. `null` = sin calibrar.
  ubicacionCalibradaEn DateTime?

  // Configuración visual/panel
  mostrarVentas             Boolean   @default(false)
  panelMode                 String    @default("")
  promocionado              Boolean   @default(false)
  ordenPromocion            Int       @default(0)
  destacadoHasta            DateTime? // fecha hasta la cual el negocio es destacado
  seguimientoDeliveryActivo Boolean   @default(false)

  // Salón / Mesas
  salonActivo      Boolean @default(false)
  empleadosActivos Boolean @default(false)
  // F10-B2.1: obligatoriedad del turno de Caja para cajeros (persistida, por
  // negocio). OPCIONAL = transicion (F10-B1 vende sin turno; si hay turno
  // abierto la venta se atribuye). OBLIGATORIO = un cajero sin turno abierto no
  // puede vender. CHECK en SQL. Sin ruta para activarlo hasta F10-B2.2.
  cajaTurnosModo   String  @default("OPCIONAL")
  // F4-C4 (P1): umbrales de las advertencias informativas de un cambio
  // comercial; NULL = predeterminado (30 días / 3 cambios anteriores). Nunca
  // bloquean una operación. CHECK en SQL. Configuración en la interfaz: F4-C5.
  cambioAvisoAntiguedadDias Int?
  cambioAvisoCadenaCambios  Int?
  // F10-C1a: importe a partir del cual un egreso de caja registrado por un
  // empleado genera un aviso destacado al dueño. NULL = sin umbral. Nunca
  // bloquea un egreso. CHECK en SQL (> 0).
  cajaEgresoAvisoUmbralDecimal Decimal? @db.Decimal(12, 2)
  zonasSalon       String  @default("[]") // JSON array of zone names

  // Pago
  aceptaTransferencia Boolean @default(false)
  aliasBancario       String  @default("")

  // Configuración de pedidos
  toleranciaCancelacion Int @default(5) // minutes
  tiempoEntrega         Int @default(30) // minutes

  // Repartidores
  repartidorCodigo String? @unique

  // Access token for employees (single shared link for pedidos + reseñas)
  tokenEmpleados String? @unique // token for /e/[token] — combined employee view

  // Access token for salon (shared link for mesas/orders view)
  tokenSalon String? @unique // token for /s/[token] — salon mesas view

  // Relations (salón)
  mesas     Mesa[]
  empleados Empleado[]
  codigosIncorporacionMozo CodigoIncorporacionMozo[]
  terminalesOperativas       TerminalOperativa[]
  vinculacionesTerminalOperativa VinculacionTerminalOperativa[]

  // Relations (Caja / Inventario — P2-T56-R1)
  movimientosInventario MovimientoInventario[]
  ventas                Venta[]
  reservasStock         ReservaStock[] // P2-T56-R3A-I1
  cobrosVenta           CobroVenta[] // F10-B0
  cuentasFinancieras    CuentaFinanciera[] // F10-B0
  operacionesFinancieras OperacionFinanciera[] // F10-B0
  movimientosFinancieros MovimientoFinanciero[] // F10-B0
  cajasFisicas           CajaFisica[] // F10-B2.1
  turnosCaja             TurnoCaja[] // F10-B2.1
  devolucionesVenta      DevolucionVenta[] // F4-A
  correccionesVenta      CorreccionVenta[] // F4-B
  cambiosVenta           CambioVenta[] // F4-C3
  intentosComerciales    IntentoCajaComercial[] // F4-C5
  traspasosFondoTurnos   TraspasoFondoTurnoCaja[] // F10-B2.2-F
  egresosCaja            EgresoCaja[] // F10-C1a
  proveedores            Proveedor[] // F5-A
  obligacionesProveedor  ObligacionProveedor[] // F5-A
  creditosProveedor      CreditoProveedor[] // F5-A
  operacionesAsignacion  OperacionAsignacion[] // F5-A
  asignacionesPago       AsignacionPago[] // F5-A
  configuracionCompras   ConfiguracionCompras? // F10-C2a
  compras                Compra[] // F10-C2a
  recepciones            Recepcion[] // F10-C2a
  costosVigentes         CostoVigente[] // F10-C2a
  proveedorProductos     ProveedorProducto[] // F5 productos por proveedor
  importacionesProductos ImportacionProductos[] // Catálogo: importaciones masivas (Excel/CSV)

  // Plan
  planTipo            String  @default("prueba")
  planVencimiento     String?
  planFechaInicio     String?
  planFechaRenovacion String?

  // Push
  pushSubscription          String?
  // Separate push subscriptions for the shared-display PWAs:
  //  - pushSubscriptionSalon:      /s/[token] salon view (kitchen/tablet)
  //  - pushSubscriptionEmpleados:  /e/[token] empleados panel (pedidos + reseñas)
  // These are intentionally separate from `pushSubscription` (which is the
  // business owner's personal subscription on the /negocio panel) so a
  // single device can subscribe on multiple shared displays without wiping
  // the owner's subscription.
  pushSubscriptionSalon     String?
  pushSubscriptionEmpleados String?

  // Monetización
  deudaTarifa Float  @default(0)
  limiteDeuda Float?

  // Rating cache
  puntuacionPromedio Float @default(0)
  totalResenas       Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productos            Producto[]
  agregados            Agregado[]
  ingredientes         Ingrediente[]
  pedidos              Pedido[]
  resenas              Resena[]
  solicitudesRevisionResena SolicitudRevisionResena[]
  favoritos            Favorito[]
  deudaHistorial       DeudaHistorial[]
  repartidores         RepartidorNegocio[]
  secciones            SeccionCatalogo[]
  opcionesCompartidas  OpcionesCompartidas[]
  promociones          Promocion[]
  denuncias            Denuncia[]
  solicitudesDestacado DestacadoSolicitud[]
  ocupacionesMesa      SesionOcupacionMesa[]

  pagosRecepcion         PagoRecepcion[] // D-7 v2
  cambiosPrecioVenta     CambioPrecioVenta[] // F10-C2b precios
  etiquetasPrecio        EtiquetaPrecio[] // F10-C2c etiquetas de góndola
  activacionesPrecio     ActivacionPrecioVenta[] // F10-C2c
  iniciosVenta           InicioVenta[] // F10-C2c precios por inicio de venta
  // T7-F1 retiros personales de mercadería
  familiaresRetiro           FamiliarRetiro[]
  retirosPersonales          RetiroPersonal[]
  retiroPersonalLineas       RetiroPersonalLinea[]
  devolucionesRetiro         DevolucionRetiroPersonal[]
  devolucionRetiroLineas     DevolucionRetiroLinea[]
  decisionesRecuperoRetiro   DecisionRecuperoRetiro[]
  decisionRecuperoRetiroItems DecisionRecuperoRetiroItem[]
  @@map("negocios")
}

// ============================================
// SECCIONES CATÁLOGO
// ============================================
model SeccionCatalogo {
  id          String  @id @default(cuid())
  nombre      String
  orientacion String  @default("vertical") // horizontal, vertical
  orden       Int     @default(0)
  color       String  @default("")
  negocioId   String
  negocio     Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  productos SeccionProducto[]

  @@map("secciones_catalogo")
}

model SeccionProducto {
  id         String          @id @default(cuid())
  seccionId  String
  productoId String
  seccion    SeccionCatalogo @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  producto   Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  orden      Int             @default(0)

  @@unique([seccionId, productoId])
  @@map("seccion_productos")
}

// ============================================
// PRODUCTOS
// ============================================
model Producto {
  id            String  @id @default(cuid())
  nombre        String
  precio        Float
  categoria     String  @default("Sin Categoria")
  imagenUrl     String?
  imagenesExtra String  @default("[]") // JSON array of URLs
  negocioId     String
  stock         Boolean @default(true)
  eliminado     Boolean @default(false)

  // Descuentos
  descuentoActivo Boolean @default(false)
  tipoDescuento   String  @default("porcentaje") // porcentaje, monto
  valorDescuento  Float   @default(0)

  // Restaurante
  descripcion            String?
  secciones              String  @default("[]") // JSON: product option sections
  recomendados           String  @default("[]") // JSON array of product IDs
  opcionesCompartidasIds String  @default("[]") // JSON array of shared option IDs

  // Ropa
  talles   String @default("[]") // JSON array
  colores  String @default("[]") // JSON array
  material String @default("")
  genero   String @default("")

  // Inventario (P2-T56-R1): additive, generic-vertical stock tracking.
  // Every existing Producto (Restaurante/Ropa) keeps controlStock=false and
  // is completely unaffected — these fields are only read/written by the
  // new Inventario/Caja surfaces. stockCantidad/stockMinimo are Float (not
  // Int) so a future kg/litro sale doesn't require a second migration.
  sku           String?
  codigoBarras  String?
  costo         Float?
  marca         String?
  unidadMedida  String  @default("unidad") // unidad, kg, g, litro, ml, metro, caja, paquete, otro
  controlStock  Boolean @default(false)
  stockCantidad Float   @default(0)
  stockMinimo   Float   @default(0)

  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocio               Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  agregados             ProductoAgregado[]
  ingredientes          ProductoIngrediente[]
  seccionItems          SeccionProducto[]
  itemsPedido           PedidoItem[]
  promociones           Promocion[]
  movimientosInventario MovimientoInventario[]
  ventaItems            VentaItem[]
  variantes             ProductoVariante[]
  compraLineas          CompraLinea[] // F10-C2a
  recepcionLineas       RecepcionLinea[] // F10-C2a
  costosVigentes        CostoVigente[] // F10-C2a
  proveedorProductos    ProveedorProducto[] // F5 productos por proveedor
  reservasStock         ReservaStock[] // P2-T56-R3A-I1

  cambiosPrecioVenta    CambioPrecioVenta[] // F10-C2b precios
  etiquetasPrecio       EtiquetaPrecio[] // F10-C2c
  activacionesPrecio    ActivacionPrecioVenta[] // F10-C2c
  retiroPersonalLineas  RetiroPersonalLinea[] // T7-F1
  @@map("productos")
}

// ============================================
// PRODUCTO — VARIANTES (P2-T56-R2C)
// ============================================
// Additive only: a Producto with zero rows here behaves EXACTLY as before
// (Restaurante/Ropa/every existing generic-business product) — its own
// precio/costo/stockCantidad/controlStock/sku/codigoBarras remain the sole
// authority. The moment a Producto has >=1 ProductoVariante row (active or
// inactive), those Producto-level operational fields become dormant for
// sale/stock purposes (never zeroed, never deleted — see the R2C report's
// BASE_TO_VARIANTS_STOCK_BEHAVIOR) and every variant carries its own
// authoritative precio/costo/stock, independent of every sibling variant and
// of the parent Producto. Never DELETE — see VARIANT_DELETE_BEHAVIOR in the
// R2C report: `activo` is the only removal mechanism, so a variant already
// referenced by a historical VentaItem/MovimientoInventario is never
// orphaned or destroyed.
model ProductoVariante {
  id            String  @id @default(cuid())
  productoId    String
  nombre        String
  precio        Float
  costo         Float?
  sku           String?
  codigoBarras  String?
  controlStock  Boolean @default(false)
  stockCantidad Float   @default(0)
  stockMinimo   Float   @default(0)
  activo        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producto              Producto               @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ventaItems            VentaItem[]
  movimientosInventario MovimientoInventario[]
  pedidoItems           PedidoItem[]
  reservasStock         ReservaStock[] // P2-T56-R3A-I1
  compraLineas          CompraLinea[] // F10-C2a
  recepcionLineas       RecepcionLinea[] // F10-C2a
  costosVigentes        CostoVigente[] // F10-C2a
  proveedorProductos    ProveedorProducto[] // F5 productos por proveedor

  cambiosPrecioVenta    CambioPrecioVenta[] // F10-C2b precios
  etiquetasPrecio       EtiquetaPrecio[] // F10-C2c
  activacionesPrecio    ActivacionPrecioVenta[] // F10-C2c
  retiroPersonalLineas  RetiroPersonalLinea[] // T7-F1
  @@index([productoId])
  @@map("producto_variantes")
}

// ============================================
// INVENTARIO — MOVIMIENTOS DE STOCK (P2-T56-R1)
// ============================================
// Traza cada cambio de Producto.stockCantidad para un producto con
// controlStock=true. Nunca se escribe stockCantidad "a mano": todo cambio
// (alta manual, ajuste, venta desde Caja) pasa por un movimiento acá,
// dentro de la misma transacción que actualiza el producto — ver
// src/app/api/negocio/inventario/movimientos/route.ts y
// src/app/api/negocio/caja/ventas/route.ts.
model MovimientoInventario {
  id                 String   @id @default(cuid())
  negocioId          String
  productoId         String
  productoVarianteId String? // P2-T56-R2C: set only when the product has variants — stockAntes/stockDespues then describe the VARIANT's stock, never the parent Producto's
  tipo               String // ENTRADA | SALIDA | AJUSTE | VENTA | PEDIDO (PEDIDO: P2-T56-R3A, consumo de reserva — sólo servidor)
  cantidad           Float // siempre positivo; el signo real lo determina `tipo`
  stockAntes         Float
  stockDespues       Float
  motivo             String?
  ventaId            String? // presente cuando tipo = VENTA, DEVOLUCION (F4-A) o CORRECCION_* (F4-B)
  correccionVentaId  String? // F4-B: presente únicamente cuando tipo = CORRECCION_ENTRADA | CORRECCION_SALIDA
  pedidoId           String? // P2-T56-R3A-I1: presente únicamente cuando tipo = PEDIDO (ningún runtime lo escribe todavía)
  recepcionLineaId   String?  @unique // F10-C2a: presente únicamente cuando tipo = RECEPCION (una entrada por línea aprobada)
  retiroPersonalId   String? // T7-F1: presente únicamente cuando tipo = RETIRO_PERSONAL (una salida por clave agregada)
  devolucionRetiroId String? // T7-F1: presente únicamente cuando tipo = RETIRO_PERSONAL_REINGRESO
  createdAt          DateTime @default(now())

  negocio          Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: SetNull)
  venta            Venta?            @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  pedido           Pedido?           @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  devolucionItem   DevolucionVentaItem?
  correccionVenta  CorreccionVenta?  @relation(fields: [correccionVentaId], references: [id], onDelete: SetNull)
  recepcionLinea   RecepcionLinea?   @relation(fields: [recepcionLineaId], references: [id], onDelete: SetNull)
  retiroPersonal   RetiroPersonal?   @relation(fields: [retiroPersonalId], references: [id], onDelete: SetNull)
  devolucionRetiro DevolucionRetiroPersonal? @relation(fields: [devolucionRetiroId], references: [id], onDelete: SetNull)

  @@index([negocioId, productoId, createdAt])
  @@index([productoVarianteId])
  @@index([ventaId])
  @@index([pedidoId])
  @@index([correccionVentaId])
  @@index([retiroPersonalId])
  @@index([devolucionRetiroId])
  @@map("movimientos_inventario")
}

// ============================================
// RESERVAS DE STOCK DE PEDIDOS (P2-T56-R3A-I1)
// ============================================
// Modelo final de A0.1-17 (codex-reports/P2_T56_R3A_ORDER_STOCK_LIFECYCLE_DESIGN.md).
// Una reserva NUNCA cambia stock físico. I1 sólo crea la tabla: ningún runtime
// la escribe ni la lee hasta R3A-I2 (y ConfigPlataforma.stockReservaModo = OFF).
// FKs (A0.1-8): negocio CASCADE (sólo muere con su tenant); pedido/pedidoItem
// NO ACTION (protege la traza; chequeado al fin de sentencia, así la cascada
// de Negocio sigue funcionando); producto/variante SET NULL (la fila histórica
// sobrevive; el borrado de Producto con reservas ACTIVA lo bloquea un guard 409
// de aplicación en I2).
model ReservaStock {
  id                 String    @id @default(cuid())
  negocioId          String
  pedidoId           String
  pedidoItemId       String
  productoId         String? // nullable: SET NULL al borrar Producto
  productoVarianteId String? // sólo si la autoridad de stock es una variante
  cantidad           Float // misma unidad que stockCantidad (kg/litro admitidos)
  estado             String // ACTIVA | CONSUMIDA | LIBERADA
  motivoLiberacion   String? // CANCELADO_CLIENTE | CANCELADO_VENDEDOR | CANCELADO_MESA | CANCELADO_SISTEMA | ROLLBACK | PRODUCTO_ELIMINADO
  createdAt          DateTime  @default(now())
  consumidaEn        DateTime?
  liberadaEn         DateTime?

  negocio          Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  pedido           Pedido            @relation(fields: [pedidoId], references: [id], onDelete: NoAction)
  pedidoItem       PedidoItem        @relation(fields: [pedidoItemId], references: [id], onDelete: NoAction)
  producto         Producto?         @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: SetNull)

  @@unique([pedidoItemId])
  @@index([negocioId, estado, productoId, productoVarianteId])
  @@index([negocioId, productoVarianteId, estado])
  @@index([pedidoId])
  @@map("reservas_stock")
}

// ============================================
// CAJA — VENTAS PRESENCIALES (P2-T56-R1)
// ============================================
// Venta iniciada por el propio negocio desde Caja (POS presencial) —
// deliberadamente NO es un Pedido: Pedido carga semántica de
// delivery/chat/tracking/notificaciones/idempotencia pensada para el
// checkout de Cliente, que una venta de mostrador instantánea no tiene y no
// debe disparar (ver P2-T56-R1 report, sección de decisión de arquitectura).
// Total y líneas se recalculan siempre server-side; nunca se confía en un
// total enviado por el cliente HTTP (mismo principio que
// src/app/api/pedidos/route.ts).
model Venta {
  id            String   @id @default(cuid())
  negocioId     String
  total         Float
  // F10-B2.0: importe exacto (NUMERIC(12,2), ROUND_HALF_UP a centavos) escrito
  // en la misma tx que `total` (escritura doble). NULL sólo en filas creadas por
  // un código anterior antes del backfill — leer con storedMoney().
  totalDecimal  Decimal? @db.Decimal(12, 2)
  // Medio de la venta (resumen). F10-B0: se conserva como fuente de las
  // estadisticas existentes; el detalle por cobro vive en CobroVenta (D7).
  metodoPago    String // EFECTIVO | TRANSFERENCIA | OTRO
  cantidadItems Int
  createdAt     DateTime @default(now())

  // F10-B0 - idempotencia del checkout (mismo patron que Pedido, Seguridad-5C).
  // NULL en ventas historicas y en clientes legacy sin cabecera.
  idempotencyKey         String?
  idempotencyFingerprint String?
  // F10-B0 - autoria derivada SIEMPRE de la sesion del servidor.
  // NEGOCIO = dueno (sesion del negocio) | EMPLEADO = cajero (F10-B1+).
  // NULL = venta anterior a F10-B0 (sin registro de autoria).
  actorTipo  String?
  actorId    String?
  empleadoId String?
  // F10-B2.1: turno de Caja al que se atribuye la venta (resuelto por el
  // servidor desde la sesion y revalidado por el motor dentro de su tx).
  // NULL = venta sin turno (anterior a F10-B2.1 o transicion OPCIONAL).
  turnoCajaId String?
  // F4-C3: venta vinculada a una venta anterior (cambio comercial o venta
  // adicional). NULL en toda venta común. vinculoTipo: CAMBIO | ADICIONAL. Una
  // venta CAMBIO lleva metodoPago = "CAMBIO" (resumen) y sus cobros reales +
  // un cobro CREDITO_CAMBIO; invariantes en SQL (migración 20261106120000).
  ventaOrigenId String?
  vinculoTipo   String?

  negocio     Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  empleado    Empleado?              @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  // F4-C3: NoAction — una venta con ventas vinculadas no puede borrarse sola.
  ventaOrigen      Venta?        @relation("VentaVinculada", fields: [ventaOrigenId], references: [id], onDelete: NoAction)
  ventasVinculadas Venta[]       @relation("VentaVinculada")
  cambiosOrigen    CambioVenta[] @relation("CambioVentaOrigen")
  cambioNuevo      CambioVenta?  @relation("CambioVentaNueva")
  // F4-C5: claims of commercial operations on this sale (origin) / of this additional sale.
  intentosComercialesOrigen IntentoCajaComercial[] @relation("IntentoComercialOrigen")
  intentoComercial          IntentoCajaComercial?  @relation("IntentoComercialVenta")
  // F10-C2c: inicio de la venta (precios vigentes al empezarla); NULL en ventas sin inicio.
  inicioVenta               InicioVenta?
  // NoAction: un turno con ventas no puede borrarse solo.
  turnoCaja   TurnoCaja?             @relation(fields: [turnoCajaId], references: [id], onDelete: NoAction)
  items       VentaItem[]
  movimientos MovimientoInventario[]
  cobros      CobroVenta[]
  // F4-A: compensaciones auditables; la venta nunca se edita
  devoluciones DevolucionVenta[]
  // F4-B: correcciones administrativas del dueño (eventos; la venta nunca se edita)
  correcciones CorreccionVenta[]

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, createdAt])
  @@index([empleadoId])
  @@index([turnoCajaId])
  @@index([ventaOrigenId])
  @@map("ventas_caja")
}

// ============================================
// F10-B0 - COBROS POR VENTA (preparados para pagos mixtos, D7)
// ============================================
// Una venta nueva genera exactamente UN cobro (la interfaz sigue con un solo
// medio). Las ventas anteriores a F10-B0 no tienen cobros: su medio se lee de
// Venta.metodoPago (resolveCobrosVenta). Las estadisticas siguen leyendo Venta,
// asi que este registro nunca duplica totales.
// estadoConciliacion: TRANSFERENCIA nace DECLARADO = el cobro fue DECLARADO por
// quien vendio; NO es una acreditacion verificada de Mercado Pago. EFECTIVO/OTRO:
// NO_APLICA. VERIFICADO / OBSERVADO / DIFERENCIA llegan en F10-D.
model CobroVenta {
  id                 String   @id @default(cuid())
  negocioId          String
  ventaId            String
  metodo             String // EFECTIVO | TRANSFERENCIA | OTRO
  importe            Float
  importeDecimal     Decimal? @db.Decimal(12, 2) // F10-B2.0: importe exacto (escritura doble con `importe`)
  estadoConciliacion String   @default("NO_APLICA") // NO_APLICA | DECLARADO
  createdAt          DateTime @default(now())
  // F4-C3: sólo para metodo = "CREDITO_CAMBIO" — crédito interno de UN cambio
  // (único), por el importe aplicado; nunca dinero, nunca operación financiera.
  cambioVentaId      String?  @unique

  negocio             Negocio              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  venta               Venta                @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  operacionFinanciera OperacionFinanciera?
  cambioVenta         CambioVenta?         @relation(fields: [cambioVentaId], references: [id], onDelete: NoAction)

  @@index([negocioId, createdAt])
  @@index([ventaId])
  @@map("cobros_venta")
}

// ============================================
// F10-B0 - LIBRO FINANCIERO (base minima)
// ============================================
// Cuenta -> Operacion (cabecera) -> Movimientos (patas con signo). En F10-B0 solo
// se contabilizan los cobros EN EFECTIVO de Caja, en una cuenta de sistema por
// negocio ("efectivo_caja_sin_asignar") porque todavia no existen cajas fisicas.
// El libro EMPIEZA con el primer cobro registrado despues del deploy de F10-B0:
// su saldo NO reconstruye el efectivo historico del negocio, ni es el saldo de
// un cajon concreto, ni incluye fondos iniciales no declarados. Ningun saldo de
// Mercado Pago se calcula ni se muestra. Las correcciones futuras seran
// operaciones compensatorias (revierteOperacionId); los importes no se editan.
model CuentaFinanciera {
  id        String   @id @default(cuid())
  negocioId String
  clave     String // identificador estable de sistema (F10-B0: "efectivo_caja_sin_asignar")
  tipo      String // EFECTIVO (F10-B0); futuros: MERCADO_PAGO | OTRA
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  // F10-B2.1: cuenta de efectivo de una caja fisica (clave "efectivo_caja_fisica:<id>").
  // NULL = cuenta sin caja (p. ej. efectivo_caja_sin_asignar, historico).
  cajaFisicaId String?

  negocio     Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cajaFisica  CajaFisica?            @relation(fields: [cajaFisicaId], references: [id], onDelete: NoAction)
  movimientos MovimientoFinanciero[]

  @@unique([negocioId, clave])
  @@map("cuentas_financieras")
}

model OperacionFinanciera {
  id                  String   @id @default(cuid())
  negocioId           String
  tipo                String // VENTA_COBRO (F10-B0) | DEVOLUCION_VENTA (F4-A, salida de efectivo) | GASTO, PAGO_PROVEEDOR, RETIRO_DUENO (F10-C1a, egresos de caja) | REVERSION (compensación, F10-C1c) | RECUPERO_EGRESO (F10-D1); futuros: TRANSFERENCIA_INTERNA, CAMBIO_*, AJUSTE
  estado              String   @default("CONFIRMADA")
  // Origen: un cobro de venta genera a lo sumo UNA operacion (anti-duplicado).
  cobroVentaId        String?  @unique
  // Reversion compensatoria futura: una operacion se revierte a lo sumo una vez.
  revierteOperacionId String?  @unique
  actorTipo           String // NEGOCIO | EMPLEADO (derivado de la sesion)
  actorId             String
  // Idempotencia de operaciones manuales futuras (NULL para las derivadas de ventas).
  idempotencyKey      String?
  createdAt           DateTime @default(now())
  // F10-B2.1: turno de Caja al que pertenece la operacion (NULL = sin turno).
  turnoCajaId         String?

  negocio     Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  turnoCaja   TurnoCaja?             @relation(fields: [turnoCajaId], references: [id], onDelete: NoAction)
  // NoAction: una venta con registro financiero no puede borrarse sola; borrar
  // el negocio completo sigue funcionando (verificacion al final de la sentencia).
  cobroVenta  CobroVenta?            @relation(fields: [cobroVentaId], references: [id], onDelete: NoAction)
  revierte    OperacionFinanciera?   @relation("ReversionOperacionFinanciera", fields: [revierteOperacionId], references: [id], onDelete: NoAction)
  reversion   OperacionFinanciera?   @relation("ReversionOperacionFinanciera")
  movimientos MovimientoFinanciero[]
  // F4-A: reintegro en efectivo (DEVOLUCION_VENTA)
  devolucionVenta DevolucionVenta?
  // F10-C1a: egreso de caja (GASTO | PAGO_PROVEEDOR | RETIRO_DUENO) y su compensación (REVERSION)
  egresoCaja         EgresoCaja?
  compensacionEgreso CompensacionEgresoCaja?
  // F10-D1: recupero de un egreso descubierto después del cierre (RECUPERO_EGRESO)
  recuperoEgreso     RecuperoEgresoCaja?

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, createdAt])
  @@index([turnoCajaId])
  @@map("operaciones_financieras")
}

// ============================================
// F10-B2.1 — Cajas fisicas y turnos de Caja (negocios genericos)
// ============================================
// Invariantes en SQL (migracion 20261011120000, no representables en el DSL):
//   - una sola caja predeterminada ACTIVA por negocio (indice unico parcial);
//   - nombre de caja unico por negocio sin distinguir mayusculas/espacios;
//   - predeterminada implica activa (CHECK);
//   - un solo turno ABIERTO por caja, por empleado y por dueno (indices parciales);
//   - responsable coherente y fondo inicial >= 0 (CHECK);
//   - el turno y su caja son del mismo negocio (FK compuesta).
model CajaFisica {
  id               String   @id @default(cuid())
  negocioId        String
  nombre           String
  descripcion      String?
  esPredeterminada Boolean  @default(false)
  activa           Boolean  @default(true)
  // Incremented when a shift closes so pre-existing Serializable sale
  // snapshots conflict after waiting on the physical-register row lock.
  turnoLockRevision Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  negocio Negocio            @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  turnos  TurnoCaja[]
  entregasCustodia EntregaCustodiaTurnoCaja[]
  traspasosFondo TraspasoFondoTurnoCaja[]
  cuentas CuentaFinanciera[]

  @@unique([id, negocioId])
  @@index([negocioId])
  @@map("cajas_fisicas")
}

model TurnoCaja {
  id           String @id @default(cuid())
  negocioId    String
  cajaFisicaId String
  // Responsable (= quien abre en F10-B2.1), SIEMPRE derivado de la sesion:
  // NEGOCIO -> responsableId = negocioId, empleadoId NULL;
  // EMPLEADO -> responsableId = empleadoId (activo, area caja).
  responsableTipo String
  responsableId   String
  empleadoId      String?
  // F10-B2.2-C: CERRADO_DECLARADO termina el turno sin calcular/revelar diferencia.
  estado          String   @default("ABIERTO")
  abiertoEn       DateTime @default(now())
  // Dinero que ya esta fisicamente en la caja al abrir: declarado, exacto, NO es
  // venta ni ingreso (no genera operacion financiera).
  fondoInicialDecimal    Decimal  @db.Decimal(12, 2)
  cerradoEn              DateTime?
  efectivoContadoDecimal Decimal? @db.Decimal(12, 2)
  // F10-B2.2-D: exact expected-cash snapshot fixed at close. It is private
  // owner data and is never returned by operational/cashier endpoints.
  efectivoEsperadoDecimal Decimal? @db.Decimal(12, 2)
  idempotencyKey         String?
  idempotencyFingerprint String?
  cierreIdempotencyKey   String?
  cierreIdempotencyFingerprint String?
  // F10-B2.2-G: quien cerro realmente. RESPONSABLE = el propio responsable
  // (todos los cierres historicos); RECUPERACION_ADMINISTRATIVA = el dueno
  // recupero el turno de un empleado (cierreActorId = negocioId, motivo
  // obligatorio). El estado terminal sigue siendo CERRADO_DECLARADO.
  cierreOrigen           String?
  cierreActorTipo        String?
  cierreActorId          String?
  cierreMotivo           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  negocio     Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cajaFisica  CajaFisica            @relation(fields: [cajaFisicaId, negocioId], references: [id, negocioId], onDelete: NoAction)
  empleado    Empleado?             @relation(fields: [empleadoId], references: [id], onDelete: NoAction)
  ventas      Venta[]
  operaciones OperacionFinanciera[]
  revisionesAdministrativas RevisionTurnoCaja[]
  entregasCustodia EntregaCustodiaTurnoCaja[]
  traspasoFondoOrigen TraspasoFondoTurnoCaja? @relation("TraspasoFondoTurnoOrigen")
  traspasoFondoDestino TraspasoFondoTurnoCaja? @relation("TraspasoFondoTurnoDestino")
  // F4-A: devoluciones cuyo efectivo salió de este turno
  reintegrosDevolucion DevolucionVenta[]
  // F4-C3: cambios comerciales atribuidos a este turno
  cambiosVenta CambioVenta[]
  // F10-C1a: egresos de efectivo de este turno
  egresosCaja EgresoCaja[]

  retirosPersonales RetiroPersonal[] // T7-F1: retiros registrados con este turno abierto (contexto, sin efecto en el efectivo)
  @@unique([negocioId, idempotencyKey])
  @@unique([negocioId, cierreIdempotencyKey])
  @@unique([id, negocioId])
  @@unique([id, negocioId, cajaFisicaId])
  @@index([negocioId, abiertoEn])
  @@index([negocioId, cierreOrigen])
  @@index([cajaFisicaId])
  @@index([empleadoId])
  @@map("turnos_caja")
}

// F10-B2.2-D — append-only administrative review snapshots. Review events
// record the exact figures shown to the owner and never alter the employee's
// original declared count or create financial movements.
model RevisionTurnoCaja {
  id                       String   @id @default(cuid())
  negocioId                String
  turnoCajaId              String
  actorId                  String
  accion                   String   @default("REVISION_ADMINISTRATIVA")
  observacion              String?
  efectivoEsperadoDecimal  Decimal  @db.Decimal(12, 2)
  efectivoContadoDecimal   Decimal  @db.Decimal(12, 2)
  diferenciaDecimal        Decimal  @db.Decimal(13, 2)
  idempotencyKey           String
  idempotencyFingerprint   String
  createdAt                DateTime @default(now())

  turno TurnoCaja @relation(fields: [turnoCajaId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, turnoCajaId, createdAt])
  @@map("revisiones_turnos_caja")
}

// F10-B2.2-E — immutable custody events. A later correction is a new event;
// the original employee declaration and the D expected-cash snapshot remain untouched.
model EntregaCustodiaTurnoCaja {
  id                       String   @id @default(cuid())
  negocioId                String
  cajaFisicaId             String
  turnoCajaId              String
  responsableTipo          String
  responsableId            String
  empleadoId               String?
  efectivoContadoDecimal   Decimal  @db.Decimal(12, 2)
  efectivoEsperadoDecimal  Decimal  @db.Decimal(12, 2)
  diferenciaDecimal        Decimal  @db.Decimal(13, 2)
  efectivoEntregadoDecimal Decimal  @db.Decimal(12, 2)
  fondoRemanenteDecimal    Decimal  @db.Decimal(12, 2)
  destinoTipo              String
  destinoNombre            String?
  actorId                  String
  confirmadoEn             DateTime @default(now())
  observacion              String?
  tipo                     String
  secuencia                Int
  estado                   String   @default("CONFIRMADA")
  idempotencyKey           String
  idempotencyFingerprint   String
  createdAt                DateTime @default(now())

  turno TurnoCaja @relation(fields: [turnoCajaId, negocioId], references: [id, negocioId], onDelete: Restrict)
  caja  CajaFisica @relation(fields: [cajaFisicaId, negocioId], references: [id, negocioId], onDelete: NoAction)

  @@unique([negocioId, idempotencyKey])
  @@unique([negocioId, turnoCajaId, secuencia])
  @@unique([id, negocioId, cajaFisicaId, turnoCajaId])
  @@index([negocioId, turnoCajaId, secuencia])
  traspasoFondoOrigen TraspasoFondoTurnoCaja?
  @@map("entregas_custodia_turnos_caja")
}

// F10-B2.2-F — immutable custody transfer from the latest confirmed
// remainder of one closed shift to the opening fund of the next shift.
model TraspasoFondoTurnoCaja {
  id                    String   @id @default(cuid())
  negocioId             String
  cajaFisicaId          String
  turnoOrigenId         String
  entregaOrigenId       String
  turnoDestinoId        String
  montoDecimal          Decimal  @db.Decimal(12, 2)
  recibidoPorTipo       String
  recibidoPorId         String
  confirmadoEn          DateTime @default(now())
  estado                String   @default("CONFIRMADO")
  idempotencyKey        String
  idempotencyFingerprint String
  createdAt             DateTime @default(now())

  negocio       Negocio                    @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  caja          CajaFisica                 @relation(fields: [cajaFisicaId, negocioId], references: [id, negocioId], onDelete: NoAction)
  turnoOrigen   TurnoCaja                  @relation("TraspasoFondoTurnoOrigen", fields: [turnoOrigenId, negocioId, cajaFisicaId], references: [id, negocioId, cajaFisicaId], onDelete: Restrict)
  turnoDestino  TurnoCaja                  @relation("TraspasoFondoTurnoDestino", fields: [turnoDestinoId, negocioId, cajaFisicaId], references: [id, negocioId, cajaFisicaId], onDelete: Restrict)
  entregaOrigen EntregaCustodiaTurnoCaja   @relation(fields: [entregaOrigenId, negocioId, cajaFisicaId, turnoOrigenId], references: [id, negocioId, cajaFisicaId, turnoCajaId], onDelete: Restrict)

  @@unique([negocioId, idempotencyKey])
  @@unique([turnoOrigenId, negocioId, cajaFisicaId])
  @@unique([entregaOrigenId, negocioId, cajaFisicaId, turnoOrigenId])
  @@unique([turnoDestinoId, negocioId, cajaFisicaId])
  @@index([negocioId, cajaFisicaId, confirmadoEn])
  @@map("traspasos_fondo_turnos_caja")
}

model MovimientoFinanciero {
  id          String   @id @default(cuid())
  negocioId   String
  operacionId String
  cuentaId    String
  importe     Float // con signo: + entra a la cuenta, - sale
  importeDecimal Decimal? @db.Decimal(12, 2) // F10-B2.0: importe exacto con signo (escritura doble con `importe`)
  estado      String   @default("CONFIRMADO") // CONFIRMADO (F10-B0); futuros: DECLARADO | OBSERVADO
  createdAt   DateTime @default(now())

  negocio   Negocio             @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  operacion OperacionFinanciera @relation(fields: [operacionId], references: [id], onDelete: Cascade)
  cuenta    CuentaFinanciera    @relation(fields: [cuentaId], references: [id], onDelete: NoAction)

  @@unique([operacionId, cuentaId])
  @@index([cuentaId, createdAt])
  @@index([negocioId, createdAt])
  @@map("movimientos_financieros")
}

// ============================================
// F10-C1a — egresos de efectivo de Caja (migración 20261118120000)
// ============================================
// Un egreso es un evento INMUTABLE: una operación del libro (GASTO |
// PAGO_PROVEEDOR | RETIRO_DUENO) con UNA pata negativa en la cuenta de
// efectivo de la caja física, atribuida al turno ABIERTO de esa caja. El
// esperado del turno baja con la fórmula existente (fondo + patas del turno).
// Sólo cambian, por la revisión del dueño, los campos de revisión y la
// confirmación de un retiro (ninguno mueve dinero; historial en
// revisiones_egresos_caja). Invariantes y guardas en SQL.
model EgresoCaja {
  id                        String    @id @default(cuid())
  negocioId                 String
  operacionId               String    @unique
  turnoCajaId               String
  cajaFisicaId              String
  // GASTO (gasto operativo real) | PAGO_PROVEEDOR (cancela deuda/compra: F5) | RETIRO_DUENO (no es gasto)
  naturaleza                String
  // Sólo GASTO: INSUMOS | SERVICIOS | TRANSPORTE | MANTENIMIENTO | OTRO
  categoria                 String?
  medio                     String    @default("EFECTIVO")
  importeDecimal            Decimal   @db.Decimal(12, 2)
  motivo                    String
  // Responsable que entrega el efectivo = quien registra (derivado de la sesión)
  actorTipo                 String
  actorId                   String
  empleadoId                String?
  proveedorNombre           String?
  proveedorIdentificacion   String?
  comprobanteReferencia     String?
  // Sólo RETIRO_DUENO: DUENO | AUTORIZADO_POR_DUENO + nombre de quien recibe
  destinatarioTipo          String?
  destinatarioNombre        String?
  // Sólo RETIRO_DUENO: NO_REQUERIDA (lo registró el dueño) | PENDIENTE | CONFIRMADO | NO_RECIBIDO
  confirmacionRetiroEstado  String?
  confirmacionRetiroEn      DateTime?
  confirmacionRetiroActorId String?
  // Datos PRIVADOS del dueño (nunca se devuelven al cajero)
  esperadoPrevioDecimal     Decimal   @db.Decimal(13, 2)
  excedeEsperado            Boolean   @default(false)
  umbralAvisoDecimal        Decimal?  @db.Decimal(12, 2)
  superaUmbral              Boolean   @default(false)
  justificacion             String?
  // SIN_REVISAR | REVISADO | OBSERVADO
  estadoRevision            String    @default("SIN_REVISAR")
  revisadoEn                DateTime?
  revisadoPorId             String?
  idempotencyKey            String
  idempotencyFingerprint    String
  createdAt                 DateTime  @default(now())

  negocio      Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  operacion    OperacionFinanciera     @relation(fields: [operacionId], references: [id], onDelete: NoAction)
  turno        TurnoCaja               @relation(fields: [turnoCajaId, negocioId, cajaFisicaId], references: [id, negocioId, cajaFisicaId], onDelete: NoAction)
  revisiones   RevisionEgresoCaja[]
  compensacion CompensacionEgresoCaja?
  // F10-D1: correcciones posteriores al cierre (nunca modifican el egreso)
  conciliaciones ConciliacionEgresoCaja[]
  recuperos      RecuperoEgresoCaja[]
  creditosProveedor CreditoProveedor[] // F5-A: el egreso nunca se modifica; F5 sólo lo referencia

  pagoRecepcion   PagoRecepcion[] // D-7 v2
  @@unique([negocioId, idempotencyKey])
  @@unique([id, negocioId])
  @@index([negocioId, createdAt])
  @@index([turnoCajaId])
  @@map("egresos_caja")
}

// Historial append-only de revisiones del dueño (REVISION) y de la
// confirmación de un retiro registrado por un empleado (CONFIRMACION_RETIRO).
model RevisionEgresoCaja {
  id                     String   @id @default(cuid())
  negocioId              String
  egresoId               String
  // REVISION (REVISADO | OBSERVADO) | CONFIRMACION_RETIRO (CONFIRMADO | NO_RECIBIDO)
  accion                 String
  resultado              String
  observacion            String?
  actorTipo              String   @default("NEGOCIO")
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  egreso EgresoCaja @relation(fields: [egresoId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, egresoId, createdAt])
  @@map("revisiones_egresos_caja")
}

// Compensación TOTAL de un egreso (operación REVERSION con revierteOperacionId
// = la operación del egreso, una pata positiva en la misma cuenta). Preparada en
// C1a (tabla + guardas SQL); la ejecuta el dueño desde F10-C1c.
// TURNO_ABIERTO: atribuida al mismo turno, todavía abierto.
// POSTERIOR_AL_CIERRE: SIN turno (turnoCajaId NULL): el cierre, su esperado y
// sus revisiones nunca cambian.
model CompensacionEgresoCaja {
  id                     String   @id @default(cuid())
  negocioId              String
  egresoId               String   @unique
  operacionId            String   @unique
  momento                String
  turnoCajaId            String?
  cajaFisicaId           String
  importeDecimal         Decimal  @db.Decimal(12, 2)
  motivo                 String
  actorTipo              String   @default("NEGOCIO")
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  egreso    EgresoCaja          @relation(fields: [egresoId, negocioId], references: [id, negocioId], onDelete: Cascade)
  operacion OperacionFinanciera @relation(fields: [operacionId], references: [id], onDelete: NoAction)

  @@unique([negocioId, idempotencyKey])
  @@unique([egresoId, negocioId])
  @@map("compensaciones_egresos_caja")
}

// ============================================
// F10-D1 — correcciones de egresos descubiertas DESPUÉS del cierre (migración 20261127120000)
// ============================================
// Nunca reabren ni modifican el turno cerrado, el egreso ni su operación; nunca crean una REVERSION sin turno
// (el bloqueo de 20261118150000 sigue vigente). Inmutables; guardas en SQL (topes por egreso y por turno).
//
// CONCILIACIÓN: el efectivo NO salió (SIN_SALIDA, todo el egreso) o salió menos (IMPORTE_EXCEDENTE, una parte).
// Explica parte del SOBRANTE del cierre congelado; no crea ningún movimiento de dinero.
// obligacionAjusteId: AJUSTE_DEUDA ERROR_DE_CARGA de F5 cuando el pago estaba vinculado a un proveedor.
model ConciliacionEgresoCaja {
  id                     String   @id @default(cuid())
  negocioId              String
  egresoId               String
  turnoCajaId            String // el turno CERRADO del egreso
  cajaFisicaId           String
  tipo                   String // SIN_SALIDA | IMPORTE_EXCEDENTE
  importeDecimal         Decimal  @db.Decimal(12, 2)
  motivo                 String
  obligacionAjusteId     String?  @unique
  actorTipo              String   @default("NEGOCIO")
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  egreso EgresoCaja @relation(fields: [egresoId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, egresoId])
  @@index([turnoCajaId])
  @@index([negocioId, createdAt])
  @@map("conciliaciones_egresos_caja")
}

// RECUPERO: el efectivo salió y vuelve después. Operación RECUPERO_EGRESO con UNA pata positiva en la cuenta de
// efectivo de la caja que lo recibe, atribuida a su turno ABIERTO (turnoCajaId / cajaFisicaId = receptor).
// No es venta ni cobro. obligacionAjusteId: AJUSTE_DEUDA DIFERENCIA_ACORDADA de F5 (DF-2) si estaba vinculado.
model RecuperoEgresoCaja {
  id                     String   @id @default(cuid())
  negocioId              String
  egresoId               String
  operacionId            String   @unique
  turnoCajaId            String
  cajaFisicaId           String
  importeDecimal         Decimal  @db.Decimal(12, 2)
  motivo                 String
  obligacionAjusteId     String?  @unique
  actorTipo              String   @default("NEGOCIO")
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  egreso    EgresoCaja          @relation(fields: [egresoId, negocioId], references: [id, negocioId], onDelete: Cascade)
  operacion OperacionFinanciera @relation(fields: [operacionId], references: [id], onDelete: NoAction)

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, egresoId])
  @@index([turnoCajaId])
  @@index([negocioId, createdAt])
  @@map("recuperos_egresos_caja")
}

// ============================================
// F5-A — proveedores y motor ÚNICO de cuenta corriente (migración 20261119180000)
// ============================================
// Diseño: codex-reports/F10_C2_F5_COMPRAS_RECEPCION_DISENO.md v2 §4, §5, §7, §10.
// Una OBLIGACIÓN es lo que se le debe al proveedor; un CRÉDITO lo que reduce esa
// deuda. Una ASIGNACIÓN atribuye parte de un crédito EFECTIVO a una obligación
// VIGENTE del MISMO proveedor (FKs compuestas (id, proveedorId, negocioId)).
// Todo es append-only: nada confirmado se edita; anulaciones, confirmaciones,
// rechazos y desvinculaciones son eventos; las desafectaciones son filas nuevas.
// La deuda no es dinero: ninguna fila de F5 tiene patas en el libro financiero.
// El efectivo sólo sale por F10-C1 (EgresoCaja PAGO_PROVEEDOR, que F5 sólo
// REFERENCIA; la fila del egreso nunca se toca). Invariantes en SQL.
model Proveedor {
  id                String   @id @default(cuid())
  negocioId         String
  nombre            String
  // minúsculas, sin tildes, espacios simples: sólo para advertir nombres similares (no es único)
  nombreNormalizado String
  // 11 dígitos con dígito verificador válido; ÚNICO por negocio cuando existe (índice parcial en SQL)
  cuit              String?
  telefono          String?
  email             String?
  notas             String?
  activo            Boolean  @default(true)
  actorId           String
  idempotencyKey    String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  negocio      Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cambios      ProveedorCambio[]
  obligaciones ObligacionProveedor[]
  creditos     CreditoProveedor[]
  operaciones  OperacionAsignacion[]
  compras      Compra[] // F10-C2a
  recepciones  Recepcion[] // F10-C2a
  productos    ProveedorProducto[] // F5 productos por proveedor
  cargosRecepcion RecepcionCargo[] // F10-C2a

  pagosRecepcion PagoRecepcion[] // D-7 v2
  @@unique([negocioId, idempotencyKey])
  @@unique([id, negocioId])
  @@index([negocioId, nombreNormalizado])
  @@map("proveedores")
}

// Historial append-only de cambios de ficha (qué campos y sus valores anteriores).
model ProveedorCambio {
  id                String   @id @default(cuid())
  negocioId         String
  proveedorId       String
  campos            String // JSON: lista de campos cambiados
  valoresAnteriores String // JSON: valores anteriores de esos campos
  actorId           String
  createdAt         DateTime @default(now())

  proveedor Proveedor @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@index([negocioId, proveedorId, createdAt])
  @@map("proveedor_cambios")
}

// Lo que se le DEBE al proveedor. Importe > 0, inmutable.
// origen: SALDO_INICIAL (deuda anterior al uso de DeliGO, a una fecha de corte; a lo sumo una VIGENTE por proveedor)
//       | AJUSTE_DEUDA (dueño, con naturaleza y motivo)
//       | RECEPCION / CARGO_ACCESORIO (reservados para F10-C2a: una obligación por recepción aprobada — recepcionId único)
// estado: VIGENTE → ANULADA (sólo sin asignaciones vigentes; evento ANULACION)
model ObligacionProveedor {
  id                     String    @id @default(cuid())
  negocioId              String
  proveedorId            String
  origen                 String
  // AJUSTE_DEUDA: ERROR_DE_CARGA | DIFERENCIA_ACORDADA | RECARGO | OTRO
  naturalezaAjuste       String?
  importeDecimal         Decimal   @db.Decimal(12, 2)
  fecha                  DateTime
  descripcion            String
  comprobanteTipo        String?
  comprobanteNumero      String?
  comprobanteFecha       DateTime?
  // F10-C2a: origen RECEPCION (único por recepción) / CARGO_ACCESORIO (único por cargo)
  recepcionId            String?
  recepcionCargoId       String?
  estado                 String    @default("VIGENTE")
  anuladaEn              DateTime?
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime  @default(now())

  negocio     Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  proveedor   Proveedor               @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  eventos     EventoCuentaProveedor[]
  asignaciones AsignacionPago[]
  recepcion      Recepcion?      @relation(fields: [recepcionId, negocioId], references: [id, negocioId], onDelete: NoAction)
  recepcionCargo RecepcionCargo? @relation(fields: [recepcionCargoId, negocioId], references: [id, negocioId], onDelete: NoAction)

  @@unique([negocioId, idempotencyKey])
  @@unique([id, negocioId])
  @@unique([id, proveedorId, negocioId])
  @@index([negocioId, proveedorId, estado])
  @@map("obligaciones_proveedor")
}

// Lo que REDUCE la deuda. Importe > 0, inmutable salvo su estado (con evento).
// origen / estados:
//   PAGO_CAJA      VIGENTE → DESVINCULADO          (referencia a un egreso PAGO_PROVEEDOR de F10-C1; importe = el del egreso)
//   PAGO_DECLARADO DECLARADO → CONFIRMADO_DUENO → ANULADO ; DECLARADO → RECHAZADO
//                  (transferencia / Mercado Pago / otro; DECLARADO no reduce la deuda ni se asigna)
//   AJUSTE_A_FAVOR VIGENTE → ANULADO               (dueño, con naturaleza y motivo; no es dinero)
// EFECTIVO (cuenta para la deuda y se puede asignar) = estado VIGENTE o CONFIRMADO_DUENO.
// La conciliación bancaria de F10-D es OTRA cosa (conciliacion*: siempre NULL en F5-A).
model CreditoProveedor {
  id                     String    @id @default(cuid())
  negocioId              String
  proveedorId            String
  origen                 String
  importeDecimal         Decimal   @db.Decimal(12, 2)
  estado                 String
  egresoCajaId           String?
  medio                  String?
  referencia             String?
  fechaPago              DateTime?
  cuentaOrigenDeclarada  String?
  naturalezaAjuste       String?
  motivo                 String?
  confirmadoEn           DateTime?
  confirmadoPorId        String?
  cerradoEn              DateTime?
  // Reservado F10-D (conciliación bancaria real): NULL en F5-A (CHECK)
  conciliacionEstado     String?
  conciliadoEn           DateTime?
  conciliacionRef        String?
  // Reservado F10-C2a (anticipo con referencia no vinculante a una compra): NULL en F5-A
  compraReferenciaId     String?
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime  @default(now())

  negocio      Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  proveedor    Proveedor               @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  egresoCaja   EgresoCaja?             @relation(fields: [egresoCajaId, negocioId], references: [id, negocioId], onDelete: NoAction)
  // Pagos E1: pago (transferencia) ligado a su pedido — mismo proveedor y negocio; inmutable.
  compraReferencia Compra?             @relation(fields: [compraReferenciaId, proveedorId, negocioId], references: [id, proveedorId, negocioId], onDelete: NoAction)
  eventos      EventoCuentaProveedor[]
  asignaciones AsignacionPago[]

  pagosRecepcion PagoRecepcion[] // D-7 v2
  @@unique([negocioId, idempotencyKey])
  @@unique([id, negocioId])
  @@unique([id, proveedorId, negocioId])
  @@index([negocioId, proveedorId, estado])
  @@index([egresoCajaId])
  @@map("creditos_proveedor")
}

// Eventos de estado (append-only): ANULACION | CONFIRMACION | RECHAZO | DESVINCULACION.
model EventoCuentaProveedor {
  id                     String   @id @default(cuid())
  negocioId              String
  obligacionId           String?
  creditoId              String?
  tipo                   String
  motivo                 String?
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  obligacion ObligacionProveedor? @relation(fields: [obligacionId, negocioId], references: [id, negocioId], onDelete: Cascade)
  credito    CreditoProveedor?    @relation(fields: [creditoId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, obligacionId])
  @@index([negocioId, creditoId])
  @@map("eventos_cuenta_proveedor")
}

// Una operación del dueño sobre asignaciones: ASIGNAR | DESAFECTAR | REASIGNAR (idempotente, auditada).
model OperacionAsignacion {
  id                     String   @id @default(cuid())
  negocioId              String
  proveedorId            String
  tipo                   String
  motivo                 String?
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  negocio      Negocio          @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  proveedor    Proveedor        @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  asignaciones AsignacionPago[]

  @@unique([negocioId, idempotencyKey])
  @@unique([id, proveedorId, negocioId])
  @@map("operaciones_asignacion")
}

// Renglón de asignación (append-only). ASIGNACION atribuye `importe` de un crédito EFECTIVO a una
// obligación VIGENTE; DESAFECTACION anula exactamente UNA asignación (revierteAsignacionId único).
// Las FKs compuestas obligan a que operación, crédito y obligación sean del MISMO proveedor y negocio.
model AsignacionPago {
  id                   String   @id @default(cuid())
  negocioId            String
  proveedorId          String
  operacionId          String
  creditoId            String
  obligacionId         String
  tipo                 String
  importeDecimal       Decimal  @db.Decimal(12, 2)
  revierteAsignacionId String?  @unique
  createdAt            DateTime @default(now())

  negocio    Negocio             @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  operacion  OperacionAsignacion @relation(fields: [operacionId, proveedorId, negocioId], references: [id, proveedorId, negocioId], onDelete: Cascade)
  credito    CreditoProveedor    @relation(fields: [creditoId, proveedorId, negocioId], references: [id, proveedorId, negocioId], onDelete: Cascade)
  obligacion ObligacionProveedor @relation(fields: [obligacionId, proveedorId, negocioId], references: [id, proveedorId, negocioId], onDelete: Cascade)
  revierte   AsignacionPago?     @relation("DesafectacionAsignacion", fields: [revierteAsignacionId], references: [id], onDelete: NoAction)
  revertidaPor AsignacionPago?   @relation("DesafectacionAsignacion")

  @@index([negocioId, creditoId])
  @@index([negocioId, obligacionId])
  @@index([operacionId])
  @@map("asignaciones_pago")
}

// ============================================
// F10-C2a — compras y recepciones de mercadería (migración 20261120120000)
// ============================================
// Diseño: codex-reports/F10_C2_F5_COMPRAS_RECEPCION_DISENO.md v2 §4.4, §6, §7, §8.
// Un BORRADOR no mueve stock ni genera deuda. Sólo el DUEÑO aprueba: en UNA transacción
// Serializable se congelan los costos de cada línea, entra el stock por la autoridad R3A
// (un MovimientoInventario RECEPCION por línea, recepcionLineaId único), se actualiza el
// «último costo» respetando el orden real de las recepciones, nace UNA obligación de F5
// (recepcionId único) más una por cada cargo accesorio adeudado a otro proveedor o no
// atribuible, y opcionalmente se aplican anticipos con el motor único de F5. Aprobada,
// rechazada o descartada, la recepción es inmutable (triggers); las correcciones son
// documentos nuevos. Ninguna fila de C2a toca el libro financiero ni los egresos de Caja.

// Configuración de compras del negocio (D-4): cómo tratan los impuestos el costo de inventario.
model ConfiguracionCompras {
  negocioId            String   @id
  // IMPUESTOS_INTEGRAN_COSTO (por defecto: el impuesto no se recupera) | IMPUESTOS_RECUPERABLES (responsable inscripto)
  tratamientoImpuestos String   @default("IMPUESTOS_INTEGRAN_COSTO")
  updatedAt            DateTime @updatedAt

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@map("configuracion_compras")
}

// Pedido a un proveedor (documento comercial: no mueve dinero ni stock). Se recibe en una o
// varias recepciones; lo recibido se DERIVA de las recepciones aprobadas.
// estado: ABIERTA → CERRADA_CON_FALTANTE (el dueño da por terminado lo que falta) | ANULADA (sin recepciones aprobadas)
model Compra {
  id                     String    @id @default(cuid())
  negocioId              String
  proveedorId            String
  numero                 Int
  estado                 String    @default("ABIERTA")
  fechaPedido            DateTime
  notas                  String?
  cerradaEn              DateTime?
  // Pedido con total informado y costos unitarios desconocidos (referencia comercial: no genera deuda).
  totalInformadoDecimal  Decimal?  @db.Decimal(12, 2)
  totalInformadoIva      String? // INCLUYE_IVA | SIN_IVA | NO_SE_SABE
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime  @default(now())

  negocio     Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  proveedor   Proveedor               @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  lineas      CompraLinea[]
  recepciones Recepcion[]
  eventos     EventoCompraRecepcion[]
  pagosAnticipados CreditoProveedor[] // Pagos E1: pagos ligados al pedido

  @@unique([negocioId, numero])
  @@unique([negocioId, idempotencyKey])
  @@unique([id, negocioId])
  @@unique([id, proveedorId, negocioId])
  @@index([negocioId, proveedorId, estado])
  @@map("compras")
}

// Renglón pedido (inmutable). Producto borrado → productoId NULL; el nombre queda guardado.
model CompraLinea {
  id                         String   @id @default(cuid())
  negocioId                  String
  compraId                   String
  orden                      Int
  productoId                 String?
  productoVarianteId         String?
  productoNombre             String
  varianteNombre             String?
  cantidadPedidaDecimal      Decimal  @db.Decimal(14, 3)
  costoUnitarioAcordadoDecimal Decimal? @db.Decimal(14, 4)
  createdAt                  DateTime @default(now())

  compra           Compra            @relation(fields: [compraId, negocioId], references: [id, negocioId], onDelete: Cascade)
  producto         Producto?         @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: SetNull)
  recepcionLineas  RecepcionLinea[]

  @@unique([id, negocioId])
  @@unique([compraId, orden])
  @@map("compra_lineas")
}

// Una entrega física de mercadería (directa o contra un pedido).
// estado: BORRADOR → PENDIENTE_APROBACION → APROBADA | RECHAZADA ; PENDIENTE_APROBACION → BORRADOR (devuelta) ;
//         BORRADOR → DESCARTADA ; el dueño puede aprobar o rechazar también desde BORRADOR.
// Los totales (*Decimal de aprobación) son NULL hasta aprobar y luego se congelan.
model Recepcion {
  id                     String    @id @default(cuid())
  negocioId              String
  proveedorId            String
  compraId               String?
  numero                 Int
  estado                 String    @default("BORRADOR")
  preparadaPorTipo       String // NEGOCIO | EMPLEADO
  preparadaPorEmpleadoId String?
  fechaRecepcion         DateTime
  comprobanteTipo        String?
  comprobanteNumero      String?
  comprobanteFecha       DateTime?
  // tipo|número normalizado: único entre las recepciones APROBADAS del mismo proveedor (D-5)
  comprobanteClave       String?
  descuentoGlobalDecimal Decimal   @default(0) @db.Decimal(12, 2)
  percepcionesDecimal    Decimal   @default(0) @db.Decimal(12, 2)
  notas                  String?
  version                Int       @default(1)
  contenidoHuella        String
  enviadaEn              DateTime?
  aprobadaEn             DateTime?
  rechazadaEn            DateTime?
  descartadaEn           DateTime?
  motivoRechazo          String?
  // Instantánea de la aprobación
  tratamientoImpuestos   String?
  netoDecimal            Decimal?  @db.Decimal(12, 2)
  descuentosDecimal      Decimal?  @db.Decimal(12, 2)
  impuestosDecimal       Decimal?  @db.Decimal(12, 2)
  cargosDecimal          Decimal?  @db.Decimal(12, 2)
  totalObligacionDecimal Decimal?  @db.Decimal(12, 2)
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  negocio      Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  proveedor    Proveedor               @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  compra       Compra?                 @relation(fields: [compraId, proveedorId, negocioId], references: [id, proveedorId, negocioId], onDelete: NoAction)
  lineas       RecepcionLinea[]
  cargos       RecepcionCargo[]
  eventos      EventoCompraRecepcion[]
  obligaciones ObligacionProveedor[]

  pagos           PagoRecepcion[] // D-7 v2
  cambiosPrecio   CambioPrecioVenta[] // F10-C2b precios
  @@unique([negocioId, numero])
  @@unique([negocioId, idempotencyKey])
  @@unique([id, negocioId])
  @@index([negocioId, estado, createdAt])
  @@index([negocioId, proveedorId])
  @@index([compraId])
  @@map("recepciones")
}

// Renglón recibido. aceptada + rechazada = recibida; sólo lo ACEPTADO entra al stock y a la deuda.
// costoUnitario = precio unitario neto del comprobante (antes del descuento de línea).
// Los campos de aprobación (subtotal … costoUnitarioInventario) se congelan al aprobar.
model RecepcionLinea {
  id                               String    @id @default(cuid())
  negocioId                        String
  recepcionId                      String
  orden                            Int
  compraLineaId                    String?
  productoId                       String?
  productoVarianteId               String?
  productoNombre                   String
  varianteNombre                   String?
  cantidadRecibidaDecimal          Decimal   @db.Decimal(14, 3)
  cantidadAceptadaDecimal          Decimal   @db.Decimal(14, 3)
  cantidadRechazadaDecimal         Decimal   @db.Decimal(14, 3)
  // DANADO | VENCIDO | NO_PEDIDO | ERROR_PROVEEDOR | OTRO (obligatorio si hay rechazo)
  motivoRechazo                    String?
  detalleRechazo                   String?
  costoUnitarioDecimal             Decimal   @db.Decimal(14, 4)
  descuentoPctDecimal              Decimal   @default(0) @db.Decimal(5, 2)
  alicuotaImpuestoPctDecimal       Decimal   @default(0) @db.Decimal(5, 2)
  // Instantánea de la aprobación
  controlStockAlAprobar            Boolean?
  subtotalDecimal                  Decimal?  @db.Decimal(12, 2)
  descuentoLineaDecimal            Decimal?  @db.Decimal(12, 2)
  descuentoGlobalDecimal           Decimal?  @db.Decimal(12, 2)
  netoDecimal                      Decimal?  @db.Decimal(12, 2)
  impuestosDecimal                 Decimal?  @db.Decimal(12, 2)
  percepcionDecimal                Decimal?  @db.Decimal(12, 2)
  cargosDecimal                    Decimal?  @db.Decimal(12, 2)
  costoInventarioTotalDecimal      Decimal?  @db.Decimal(12, 2)
  costoUnitarioInventarioDecimal   Decimal?  @db.Decimal(14, 4)
  createdAt                        DateTime  @default(now())

  recepcion            Recepcion             @relation(fields: [recepcionId, negocioId], references: [id, negocioId], onDelete: Cascade)
  compraLinea          CompraLinea?          @relation(fields: [compraLineaId, negocioId], references: [id, negocioId], onDelete: NoAction)
  producto             Producto?             @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoVariante     ProductoVariante?     @relation(fields: [productoVarianteId], references: [id], onDelete: SetNull)
  movimientoInventario MovimientoInventario?
  costosVigentes       CostoVigente[]

  cambiosPrecio   CambioPrecioVenta[] // F10-C2b precios
  @@unique([id, negocioId])
  @@unique([recepcionId, orden])
  @@index([compraLineaId])
  @@map("recepcion_lineas")
}

// Cargo accesorio (D-10). ATRIBUIBLE: entra al costo de inventario de las líneas (por VALOR o por
// CANTIDAD); si lo cobra el mismo proveedor va en la obligación de la recepción, si lo cobra otro
// nace una obligación CARGO_ACCESORIO para ese proveedor. NO_ATRIBUIBLE: gasto operativo (nunca
// inventario) con su propia obligación CARGO_ACCESORIO. Cada peso se cuenta una sola vez.
model RecepcionCargo {
  id                String   @id @default(cuid())
  negocioId         String
  recepcionId       String
  orden             Int
  tipo              String // ATRIBUIBLE | NO_ATRIBUIBLE
  proveedorId       String // quien lo cobra (por defecto, el de la recepción)
  concepto          String
  importeDecimal    Decimal  @db.Decimal(12, 2)
  distribucion      String? // VALOR | CANTIDAD (sólo ATRIBUIBLE)
  comprobanteTipo   String?
  comprobanteNumero String?
  createdAt         DateTime @default(now())

  recepcion    Recepcion             @relation(fields: [recepcionId, negocioId], references: [id, negocioId], onDelete: Cascade)
  proveedor    Proveedor             @relation(fields: [proveedorId, negocioId], references: [id, negocioId], onDelete: Cascade)
  obligaciones ObligacionProveedor[]

  @@unique([id, negocioId])
  @@unique([recepcionId, orden])
  @@map("recepcion_cargos")
}

// Historia append-only de compras y recepciones.
// tipo: ENVIO | DEVOLUCION_A_BORRADOR | APROBACION | RECHAZO | DESCARTE | ANULACION_COMPRA | CIERRE_COMPRA
model EventoCompraRecepcion {
  id                     String   @id @default(cuid())
  negocioId              String
  recepcionId            String?
  compraId               String?
  tipo                   String
  motivo                 String?
  // CIERRE_COMPRA: JSON con el motivo elegido y lo pendiente al cerrar (pedido / aceptado / pendiente por renglón).
  detalle                String?
  actorTipo              String // NEGOCIO | EMPLEADO
  actorId                String
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  recepcion Recepcion? @relation(fields: [recepcionId, negocioId], references: [id, negocioId], onDelete: Cascade)
  compra    Compra?    @relation(fields: [compraId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, recepcionId])
  @@index([negocioId, compraId])
  @@map("eventos_compra_recepcion")
}

// «Último costo» vigente por clave de stock (D-4): lo fijó la recepción más reciente por
// (fechaRecepcion, aprobadaEn, recepcionLineaId). Una recepción atrasada nunca lo pisa.
model CostoVigente {
  id                   String   @id @default(cuid())
  negocioId            String
  stockKey             String
  productoId           String
  productoVarianteId   String?
  recepcionLineaId     String
  fechaRecepcion       DateTime
  aprobadaEn           DateTime
  costoUnitarioDecimal Decimal  @db.Decimal(14, 4)
  updatedAt            DateTime @updatedAt

  negocio          Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: Cascade)
  recepcionLinea   RecepcionLinea    @relation(fields: [recepcionLineaId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@unique([negocioId, stockKey])
  @@map("costos_vigentes")
}

// Snapshot inmutable por línea — una venta histórica nunca cambia porque
// mañana cambie el nombre/precio/categoría del Producto (mismo principio
// que PedidoItem para Pedido).
model VentaItem {
  id                 String  @id @default(cuid())
  ventaId            String
  productoId         String?
  productoVarianteId String? // P2-T56-R2C
  nombre             String // snapshot: nombre del Producto base
  varianteNombre     String? // P2-T56-R2C: snapshot del nombre de la variante — nunca reconstruido por live-lookup (section 38)
  precio             Float // snapshot: precio unitario aplicado (de la variante si corresponde)
  cantidad           Float
  subtotal           Float
  subtotalDecimal    Decimal? @db.Decimal(12, 2) // F10-B2.0: round2(precio × cantidad) exacto (escritura doble con `subtotal`)

  venta            Venta             @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto         Producto?         @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: SetNull)
  devoluciones     DevolucionVentaItem[] // F4-A
  correcciones     CorreccionVentaLinea[] // F4-B

  @@map("venta_items")
}

// ============================================
// F4-A — Anulaciones y devoluciones parciales de ventas de Caja
// ============================================
// Compensación auditable: la Venta, sus VentaItem, su CobroVenta y su
// operación financiera original NUNCA se modifican. Cada anulación o
// devolución es un evento inmutable con sus líneas; la venta neta se deriva
// (total − devoluciones). El reintegro de dinero es independiente de la
// devolución comercial: NO_CORRESPONDE | PENDIENTE | REALIZADO (medio
// EFECTIVO / TRANSFERENCIA / OTRO). Sólo un reintegro REALIZADO en EFECTIVO
// mueve el libro: una operación DEVOLUCION_VENTA con una pata negativa en la
// cuenta de efectivo de la caja que entrega el dinero, atribuida al turno
// ABIERTO en ese momento (o sin turno en modo OPCIONAL). Los cierres
// históricos no cambian jamás. TRANSFERENCIA / OTRO quedan DECLARADOS (sin
// integración bancaria que confirme el reintegro).
// Invariantes en SQL (migración 20261017120000): cantidades e importes
// acumulados ≤ lo vendido, coherencia de actor y reintegro, inmutabilidad
// (sólo PENDIENTE → REALIZADO) y efectivo sólo desde un turno abierto.
model DevolucionVenta {
  id                      String    @id @default(cuid())
  negocioId               String
  ventaId                 String
  tipo                    String // ANULACION | DEVOLUCION_PARCIAL
  motivo                  String
  actorTipo               String // NEGOCIO | EMPLEADO (derivado de la sesión)
  actorId                 String
  empleadoId              String?
  importeDecimal          Decimal   @db.Decimal(12, 2) // valor comercial devuelto (precio efectivamente cobrado)
  // F4-C3: parte del valor devuelto aplicada como crédito a productos nuevos en
  // un cambio (F4-C). 0 en toda devolución F4-A común. Reintegrable =
  // importeDecimal − importeCompensadoDecimal (importeReintegrableDevolucion).
  importeCompensadoDecimal Decimal  @default(0) @db.Decimal(12, 2)
  metodoPagoVenta         String // snapshot del medio de la venta original (F4-C4: CAMBIO para una venta CAMBIO; SQL exige que coincida)
  reintegroEstado         String // NO_CORRESPONDE | PENDIENTE | REALIZADO
  reintegroMedio          String? // EFECTIVO | TRANSFERENCIA | OTRO (sólo REALIZADO)
  reintegroRegistradoEn   DateTime?
  reintegroActorTipo      String?
  reintegroActorId        String?
  reintegroOperacionId    String?   @unique // sólo REALIZADO + EFECTIVO
  reintegroTurnoCajaId    String? // turno que entregó el efectivo (NULL = sin turno, modo OPCIONAL)
  reintegroIdempotencyKey String?
  idempotencyKey          String
  idempotencyFingerprint  String
  createdAt               DateTime  @default(now())

  negocio            Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  venta              Venta                 @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  reintegroOperacion OperacionFinanciera?  @relation(fields: [reintegroOperacionId], references: [id], onDelete: NoAction)
  reintegroTurnoCaja TurnoCaja?            @relation(fields: [reintegroTurnoCajaId], references: [id], onDelete: NoAction)
  items              DevolucionVentaItem[]
  cambio             CambioVenta?

  @@unique([negocioId, idempotencyKey])
  @@unique([negocioId, reintegroIdempotencyKey])
  @@index([negocioId, createdAt])
  @@index([ventaId])
  @@index([reintegroTurnoCajaId])
  @@map("devoluciones_venta")
}

model DevolucionVentaItem {
  id                     String   @id @default(cuid())
  devolucionId           String
  negocioId              String
  ventaId                String
  ventaItemId            String
  cantidad               Float // misma unidad que VentaItem.cantidad
  importeDecimal         Decimal  @db.Decimal(12, 2)
  // REINGRESADO | NO_REINGRESA | SIN_CONTROL_STOCK | PRODUCTO_NO_DISPONIBLE
  stockResultado         String
  movimientoInventarioId String?  @unique // movimiento DEVOLUCION (sólo REINGRESADO)
  createdAt              DateTime @default(now())

  devolucion           DevolucionVenta       @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  ventaItem            VentaItem             @relation(fields: [ventaItemId], references: [id], onDelete: Cascade)
  movimientoInventario MovimientoInventario? @relation(fields: [movimientoInventarioId], references: [id], onDelete: SetNull)

  @@index([ventaItemId])
  @@index([devolucionId])
  @@map("devoluciones_venta_items")
}

// ============================================
// F4-C3 — Cambio comercial posventa (modelo de datos; sin servicio hasta F4-C4)
// ============================================
// Evento inmutable que une, en UNA transacción: la devolución de lo que sale
// (DevolucionVenta, valorada por lo efectivamente cobrado), la venta vinculada
// con lo que entra (Venta vinculoTipo CAMBIO, precio de catálogo actual) y la
// liquidación de la diferencia. Importes (codex-reports/F4_C_SALE_EXCHANGES.md §5):
//   salida = crédito + diferenciaReintegro · entrada = crédito + diferenciaCobrada
//   nunca cobro y reintegro a la vez · todos ≥ 0.
// El crédito es interno: un único CobroVenta CREDITO_CAMBIO de la venta nueva,
// sin operación financiera, nunca ingreso ni saldo a favor. Invariantes en SQL
// (migración 20261106120000). Aún no lo escribe ningún código productivo.
model CambioVenta {
  id                         String   @id @default(cuid())
  negocioId                  String
  ventaOrigenId              String
  devolucionId               String   @unique
  ventaNuevaId               String   @unique
  importeSalidaDecimal       Decimal  @db.Decimal(12, 2) // V_sal: valor devuelto (comercial)
  importeEntradaDecimal      Decimal  @db.Decimal(12, 2) // V_ent: total de la venta nueva
  creditoAplicadoDecimal     Decimal  @db.Decimal(12, 2) // C = min(V_sal, V_ent)
  diferenciaCobradaDecimal   Decimal  @db.Decimal(12, 2) // D+ = max(0, V_ent − V_sal)
  diferenciaReintegroDecimal Decimal  @db.Decimal(12, 2) // D− = max(0, V_sal − V_ent)
  liquidacion                String // SIN_DIFERENCIA | COBRO | REINTEGRO
  actorTipo                  String // NEGOCIO | EMPLEADO (derivado de la sesión)
  actorId                    String
  empleadoId                 String?
  turnoCajaId                String? // turno ABIERTO al registrar el cambio (NULL = sin turno, modo OPCIONAL)
  motivo                     String
  advertencias               Json? // advertencias registradas (precio heredado, antigüedad…) con su detalle
  idempotencyKey             String
  idempotencyFingerprint     String
  createdAt                  DateTime @default(now())

  negocio       Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  ventaOrigen   Venta           @relation("CambioVentaOrigen", fields: [ventaOrigenId], references: [id], onDelete: NoAction)
  devolucion    DevolucionVenta @relation(fields: [devolucionId], references: [id], onDelete: NoAction)
  ventaNueva    Venta           @relation("CambioVentaNueva", fields: [ventaNuevaId], references: [id], onDelete: NoAction)
  turnoCaja     TurnoCaja?      @relation(fields: [turnoCajaId], references: [id], onDelete: NoAction)
  cobroCredito  CobroVenta?
  intentoComercial IntentoCajaComercial? // F4-C5

  @@unique([negocioId, idempotencyKey])
  @@index([negocioId, createdAt])
  @@index([ventaOrigenId])
  @@map("cambios_venta")
}

// ============================================
// F4-C5 (D5, opción B) — una reserva por (negocio, Idempotency-Key) de una
// operación comercial (cambio o venta adicional vinculada)
// ============================================
// La clave primaria compartida coordina, con el índice único y no con una
// lectura previa, a la operación y a su verificación: la operación inserta
// REGISTRADO (trigger AFTER INSERT de cambios_venta / ventas_caja ADICIONAL) y
// la verificación inserta CERRADO. Exactamente una de las dos queda; una
// solicitud original que llega después del cierre se rechaza sin escribir
// nada. Un CERRADO es inmutable (trigger BEFORE UPDATE).
model IntentoCajaComercial {
  negocioId              String
  idempotencyKey         String
  tipo                   String // CAMBIO | ADICIONAL
  estado                 String // REGISTRADO | CERRADO
  ventaOrigenId          String
  cambioVentaId          String?   @unique // sólo REGISTRADO + CAMBIO
  ventaId                String?   @unique // sólo REGISTRADO + ADICIONAL
  actorTipo              String? // sólo CERRADO: NEGOCIO | EMPLEADO
  actorId                String? // sólo CERRADO: negocioId o empleadoId
  idempotencyFingerprint String? // sólo CERRADO: huella del contenido verificado
  createdAt              DateTime  @default(now())

  negocio     Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  ventaOrigen Venta        @relation("IntentoComercialOrigen", fields: [ventaOrigenId], references: [id], onDelete: NoAction)
  cambioVenta CambioVenta? @relation(fields: [cambioVentaId], references: [id], onDelete: Cascade)
  venta       Venta?       @relation("IntentoComercialVenta", fields: [ventaId], references: [id], onDelete: Cascade)

  @@id([negocioId, idempotencyKey])
  @@index([ventaOrigenId])
  @@map("intentos_caja_comerciales")
}

// ============================================
// F4-B — Corrección administrativa de ventas de Caja (sólo dueño)
// ============================================
// Evento compensatorio e inmutable: la Venta, sus VentaItem, su CobroVenta, su
// operación financiera, su actor, su fecha, su turno y los cierres NUNCA se
// modifican. Cada corrección guarda el estado completo de TODAS las líneas de la
// venta antes y después (secuencia 1, 2, …); el estado vigente de la venta es el
// de la última corrección. Cada línea conserva su VentaItem y el precio unitario
// efectivamente cobrado (no editable). Desde 2026-11-05 el producto nombrado
// debe justificar ese precio (CorreccionVentaLinea.criterioPrecio: MISMO_PRODUCTO,
// MISMA_VENTA o PRECIO_CATALOGO_ACTUAL); la regla anterior «el reemplazo hereda
// el precio cobrado» quedó revertida y sus líneas históricas (criterioPrecio
// NULL) no se reescriben. El total corregido debe ser EXACTAMENTE
// el total cobrado: F4-B no mueve dinero ni cambia el medio de pago. El stock se
// ajusta con movimientos CORRECCION_ENTRADA / CORRECCION_SALIDA. No se corrigen
// ventas con devoluciones/anulaciones (F4-A). Invariantes en SQL (migración
// 20261018120000).
model CorreccionVenta {
  id                     String   @id @default(cuid())
  negocioId              String
  ventaId                String
  secuencia              Int
  motivo                 String
  actorTipo              String // siempre NEGOCIO (dueño, derivado de la sesión)
  actorId                String
  totalDecimal           Decimal  @db.Decimal(12, 2) // = total cobrado de la venta
  idempotencyKey         String
  idempotencyFingerprint String
  createdAt              DateTime @default(now())

  negocio     Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  venta       Venta                  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  lineas      CorreccionVentaLinea[]
  movimientos MovimientoInventario[]

  @@unique([negocioId, idempotencyKey])
  @@unique([ventaId, secuencia])
  @@index([negocioId, createdAt])
  @@map("correcciones_venta")
}

model CorreccionVentaLinea {
  id                         String   @id @default(cuid())
  correccionId               String
  negocioId                  String
  ventaId                    String
  ventaItemId                String
  // Estado vigente ANTES de esta corrección (snapshot, sin FK a Producto).
  antesProductoId            String?
  antesProductoVarianteId    String?
  antesNombre                String
  antesVarianteNombre        String?
  antesCantidad              Float
  // Estado DESPUÉS (snapshot del producto realmente entregado).
  productoId                 String?
  productoVarianteId         String?
  nombre                     String
  varianteNombre             String?
  cantidad                   Float
  precio                     Float // = VentaItem.precio (precio efectivamente cobrado; no editable)
  subtotalDecimal            Decimal  @db.Decimal(12, 2)
  // F4-B (2026-11-05): why the named product is valid at that charged price —
  // MISMO_PRODUCTO (same product/variant as the original line) | MISMA_VENTA
  // (it appears in another original line of the same sale at that price) |
  // PRECIO_CATALOGO_ACTUAL (its current catalog price equaled the charged
  // price when checked — a coincidence at correction time, NOT proof of the
  // price at sale time; price consulted and check time stored below).
  // NULL = line recorded under the earlier inherited-price rule (history).
  criterioPrecio             String?
  precioCatalogoConsultado   Float?
  precioCatalogoConsultadoEn DateTime?
  createdAt                  DateTime @default(now())

  correccion CorreccionVenta @relation(fields: [correccionId], references: [id], onDelete: Cascade)
  ventaItem  VentaItem       @relation(fields: [ventaItemId], references: [id], onDelete: Cascade)

  @@unique([correccionId, ventaItemId])
  @@index([ventaItemId])
  @@map("correcciones_venta_lineas")
}

model ProductoAgregado {
  id         String   @id @default(cuid())
  productoId String
  agregadoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  agregado   Agregado @relation(fields: [agregadoId], references: [id], onDelete: Cascade)

  @@unique([productoId, agregadoId])
  @@map("producto_agregados")
}

model ProductoIngrediente {
  id            String      @id @default(cuid())
  productoId    String
  ingredienteId String
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@unique([productoId, ingredienteId])
  @@map("producto_ingredientes")
}

// ============================================
// AGREGADOS (Add-ons)
// ============================================
model Agregado {
  id        String  @id @default(cuid())
  nombre    String
  precio    Float   @default(0)
  categoria String  @default("")
  imagenUrl String?
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  productos ProductoAgregado[]

  @@map("agregados")
}

// ============================================
// INGREDIENTES
// ============================================
model Ingrediente {
  id        String  @id @default(cuid())
  nombre    String
  categoria String  @default("")
  imagenUrl String?
  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  productos ProductoIngrediente[]

  @@map("ingredientes")
}

// ============================================
// PEDIDOS (Orders)
// ============================================
model Pedido {
  id              String  @id @default(cuid())
  negocioId       String
  negocioSlug     String
  negocioNombre   String
  clienteId       String?
  clienteNombre   String
  clienteTelefono String  @default("")

  // Totales
  total          Float
  totalProductos Float
  tarifaServicio Float @default(0)
  precioDelivery Float @default(0)

  // Entrega
  metodoEntrega String  @default("retiro") // retiro, domicilio, mesa
  direccion     String?
  referencia    String?
  lat           Float?
  lng           Float?

  // Mesa / Salón
  mesaId          String?
  mesaNumero      Int?
  empleadoId      String?
  empleadoNombre  String?
  // P0-D.1: preparado, todavía sin usar — P0-D.2 recién empezará a escribirlo
  // y a exigir la credencial en POST /api/pedidos. Todos los pedidos
  // existentes y los nuevos de esta etapa quedan en NULL. SetNull: si la
  // ocupación se borra, el pedido nunca debe borrarse con ella (mismo patrón
  // que Pedido.cliente).
  ocupacionMesaId String?

  // Idempotencia de operaciones
  idempotencyKey         String?
  idempotencyFingerprint String?

  // Ubicación negocio al momento del pedido
  negocioLat Float?
  negocioLng Float?

  // Repartidor asignado (aceptación de pedido)
  repartidorId          String? // ID del repartidor que aceptó el pedido
  repartidorNombre      String? // Nombre del repartidor (denormalizado)
  repartidorAceptaFecha DateTime? // Cuándo aceptó el pedido

  // Ubicación repartidor en tiempo real (seguimiento delivery)
  repartidorLat        Float?
  repartidorLng        Float?
  repartidorLastUpdate DateTime?
  // Autoridad de orden monotónica, DB-backed, por pedido — incrementada
  // atómicamente junto con la escritura de ubicación aceptada (ver
  // POST /api/repartidor/ubicacion). Nunca se deriva del reloj de pared;
  // es la única fuente de verdad para decidir si un evento realtime o una
  // respuesta HTTP de tracking representa un estado más nuevo que el ya
  // mostrado (Tracking Latest-Wins Focal Design Correction #2).
  locationRevision     Int       @default(0)
  // Snapshot inmutable de Negocio.seguimientoDeliveryActivo tomado en el
  // momento de crear el Pedido (P2-T01). NO refleja el estado vivo del
  // negocio, ni permiso GPS del repartidor, ni presencia del cliente — sólo
  // si el tracking estaba habilitado por el negocio cuando este pedido nació.
  // false para todo pedido no-domicilio. Sin backfill: pedidos existentes
  // quedan en false (fail-closed) — ver
  // prisma/migrations/*_add_pedido_tracking_snapshot.
  seguimientoDeliveryHabilitado Boolean @default(false)

  // Epoch monotónico server-authoritative del historial de Chat visible de
  // este pedido (P2-T04, MODEL_R) — incrementado por cualquier mutación que
  // cambie lo que un cliente/negocio vería en un fetch completo (mensaje
  // nuevo, mark-read, saneamiento por eliminación de cuenta, cleanup por
  // antigüedad). NO es un conteo de mensajes ni incrementa una vez por fila.
  // Usado por la safety probe de Chat para evitar un fetch completo cuando
  // nada cambió — ver src/lib/chat-history-resync.ts.
  chatRevision Int @default(0)

  // Pago
  metodoPago String  @default("efectivo") // efectivo, transferencia
  notas      String?

  // Estado
  estado                  String    @default("recibido") // recibido, preparando, en_camino, listo_para_retirar, entregado, cancelado
  deudaAcumulada          Boolean   @default(false)
  canceladoPor            String? // cliente, vendedor, sistema
  canceladoMotivo         String?
  canceladoFecha          DateTime?
  clienteConfirmaRecibido Boolean   @default(false)
  clienteConfirmaFecha    DateTime?
  entregadoPorRepartidor  Boolean   @default(false)
  entregadoFecha          DateTime?

  fecha     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  negocio       Negocio              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cliente       Cliente?             @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  items         PedidoItem[]
  mensajes      ChatMensaje[]
  resena        Resena?
  eventos       PedidoEvento[]
  ocupacionMesa SesionOcupacionMesa? @relation(fields: [ocupacionMesaId], references: [id], onDelete: SetNull)
  // P2-T56-R3A-I1
  reservasStock         ReservaStock[]
  movimientosInventario MovimientoInventario[]

  @@unique([negocioId, idempotencyKey])
  @@index([ocupacionMesaId])
  @@map("pedidos")
}

model PedidoItem {
  id                   String  @id @default(cuid())
  pedidoId             String
  productoId           String?
  productoVarianteId   String? // P2-T56-R2C-F2
  nombre               String
  varianteNombre       String? // P2-T56-R2C-F2: snapshot del nombre de la variante — nunca reconstruido por live-lookup, mismo patrón que VentaItem.varianteNombre
  precio               Float
  cantidad             Int     @default(1)
  agregados            String  @default("[]") // JSON: [{id, nombre, precio}]
  secciones            String  @default("{}") // JSON: {sectionName: option}
  seccionesPrecios     String  @default("{}") // JSON: {key: price}
  ingredientes         String  @default("[]") // JSON
  ingredientesQuitados String  @default("[]") // JSON
  talle                String  @default("")
  color                String  @default("")

  pedido           Pedido            @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto         Producto?         @relation(fields: [productoId], references: [id])
  productoVariante ProductoVariante? @relation(fields: [productoVarianteId], references: [id], onDelete: SetNull)
  reservaStock     ReservaStock? // P2-T56-R3A-I1: 1:1 (@@unique pedidoItemId)

  @@index([productoVarianteId])
  @@map("pedido_items")
}

// ============================================
// CHAT
// ============================================
model ChatMensaje {
  id            String   @id @default(cuid())
  pedidoId      String
  remitente     String // cliente, vendedor, repartidor
  texto         String   @default("")
  imagenUrl     String?
  archivoUrl    String?
  archivoNombre String?
  archivoTipo   String?
  leido         Boolean  @default(false)
  fecha         DateTime @default(now())

  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId String?

  @@index([pedidoId, fecha])
  @@map("chat_mensajes")
}

// 19-B0.2D1: outbox durable para el borrado físico de adjuntos de Chat.
// Entidad puramente interna (sin relación a Cliente/ChatMensaje, sin
// endpoint CRUD, nunca expuesta por API/UI): guarda lo mínimo indispensable
// para reintentar `provider.destroy(identifier)` hasta que tenga éxito o el
// asset ya no exista. `identifier` es potencialmente sensible (para PDF de
// Cloudinary puede incorporar una versión saneada del nombre de archivo
// original) — nunca se loguea ni se expone; la fila se borra apenas el
// borrado remoto tiene éxito (o el asset ya no existe).
model ChatAttachmentDeletionJob {
  id            String    @id @default(cuid())
  provider      String // "cloudinary" | "local"
  resourceType  String // "image" | "raw" (cloudinary) | "file" (local)
  identifier    String // publicId (cloudinary) o path relativo bajo uploads/chat/ (local)
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([provider, resourceType, identifier])
  @@map("chat_attachment_deletion_jobs")
}

// ============================================
// RESEÑAS
// ============================================
enum EstadoModeracionResena {
  PUBLICADA
  OCULTA_EN_REVISION
  ELIMINADA_POR_MODERACION
}

enum EstadoSolicitudRevisionResena {
  PENDIENTE
  EN_REVISION
  REQUIERE_INFORMACION
  APROBADA
  RECHAZADA
  RESTAURADA_AUTOMATICAMENTE
}

enum MotivoSolicitudRevisionResena {
  FALSA
  ILEGAL
  OFENSIVA
  DISCRIMINATORIA
  OTRA_INFRACCION
}

enum TipoEventoSolicitudRevisionResena {
  SOLICITUD_CREADA
  TOMADA_EN_REVISION
  INFORMACION_REQUERIDA
  INFORMACION_APORTADA
  APROBADA
  RECHAZADA
  RESTAURADA_AUTOMATICAMENTE
}

enum ActorSolicitudRevisionResena {
  NEGOCIO
  SUPERADMIN
  SISTEMA
}

model Resena {
  id               String    @id @default(cuid())
  negocioId        String
  clienteId        String?
  clienteNombre    String
  pedidoId         String    @unique
  puntuacion       Int // 1-5
  comentario       String    @default("")
  rapidez          Int?
  calidad          Int?
  precio           Int?
  respuestaNegocio String?
  fechaRespuesta   DateTime?
  fecha            DateTime  @default(now())
  // Fuente de verdad de visibilidad pública. La solicitud conserva el expediente
  // y la reseña nunca se borra cuando la moderación aprueba una eliminación.
  estadoModeracion EstadoModeracionResena @default(PUBLICADA)
  moderadaEn       DateTime?

  negocio             Negocio                    @relation(fields: [negocioId], references: [id])
  cliente             Cliente?                   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  pedido              Pedido                     @relation(fields: [pedidoId], references: [id])
  solicitudesRevision SolicitudRevisionResena[]

  // Habilita la FK compuesta SolicitudRevisionResena(resenaId, negocioId), que
  // evita asociar en DB una reseña de un negocio con otro negocio distinto.
  @@unique([id, negocioId])
  @@map("resenas")
}

// Expediente de una solicitud del dueño del negocio. `activeKey` es la garantía
// de una sola solicitud activa: para PENDIENTE/EN_REVISION/REQUIERE_INFORMACION
// vale resenaId; para estados terminales vale NULL. El CHECK versionado en la
// migración refuerza esa correspondencia que Prisma no puede expresar.
model SolicitudRevisionResena {
  id                       String                        @id @default(cuid())
  resenaId                 String
  negocioId                String
  motivo                   MotivoSolicitudRevisionResena
  explicacionOriginal      String
  estado                   EstadoSolicitudRevisionResena @default(PENDIENTE)
  activeKey                String?                       @unique
  venceEn                  DateTime
  resueltaEn               DateTime?
  revisadaPorSuperadminId  String?
  motivoDecision           String?
  prorrogaInformacionUsada Boolean                       @default(false)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  resena                Resena                    @relation(fields: [resenaId, negocioId], references: [id, negocioId], onDelete: Restrict)
  negocio               Negocio                   @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  revisadaPorSuperadmin SuperAdmin?               @relation(fields: [revisadaPorSuperadminId], references: [id], onDelete: Restrict)
  eventos               SolicitudRevisionResenaEvento[]
  evidencias            EvidenciaSolicitudRevisionResena[]

  @@index([negocioId, estado, createdAt])
  @@index([estado, venceEn])
  @@index([resenaId, createdAt])
  @@map("solicitudes_revision_resena")
}

// Línea de tiempo append-only del expediente. `metadata` conserva solo datos
// sanitizados/no sensibles serializados como JSON; nunca contenido binario.
model SolicitudRevisionResenaEvento {
  id          String                            @id @default(cuid())
  solicitudId String
  tipo        TipoEventoSolicitudRevisionResena
  actorTipo   ActorSolicitudRevisionResena
  actorId     String?
  mensaje     String?
  metadata    String                            @default("{}")
  createdAt   DateTime                          @default(now())

  solicitud  SolicitudRevisionResena           @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  evidencias EvidenciaSolicitudRevisionResena[]

  @@index([solicitudId, createdAt])
  @@map("solicitudes_revision_resena_eventos")
}

// Solo metadata privada preparada para 19-F. No guarda URL pública, contenido
// ni rutas locales arbitrarias; storageKey se resolverá por un proxy autorizado.
model EvidenciaSolicitudRevisionResena {
  id                  String                          @id @default(cuid())
  solicitudId         String
  eventoId            String?
  uploaderTipo        ActorSolicitudRevisionResena
  uploaderId          String?
  storageKey          String                          @unique
  mimeType            String
  bytes               Int
  sha256              String
  nombrePresentacion  String
  createdAt           DateTime                        @default(now())

  solicitud SolicitudRevisionResena        @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  evento    SolicitudRevisionResenaEvento? @relation(fields: [eventoId], references: [id], onDelete: Restrict)

  @@index([solicitudId, createdAt])
  @@map("evidencias_solicitud_revision_resena")
}

// ============================================
// REPARTIDORES
// ============================================
model Repartidor {
  id               String   @id @default(cuid())
  nombre           String
  email            String   @unique
  password         String?
  googleId         String?  @unique
  telefono         String   @default("")
  pushSubscription String?
  activo           Boolean  @default(true)
  eliminado        Boolean  @default(false)
  fechaRegistro    DateTime @default(now())

  // Email verification
  emailVerified              DateTime?
  verificationToken         String?   @unique
  verificationTokenExpiresAt DateTime?

  negocios RepartidorNegocio[]

  @@map("repartidores")
}

model RepartidorNegocio {
  id              String   @id @default(cuid())
  repartidorId    String
  negocioId       String
  negocioSlug     String
  negocioNombre   String
  negocioLogoUrl  String?
  codigoAcceso    String
  fechaAsociacion DateTime @default(now())

  repartidor Repartidor @relation(fields: [repartidorId], references: [id], onDelete: Cascade)
  negocio    Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([repartidorId, negocioId])
  @@map("repartidor_negocios")
}

// ============================================
// SUPERADMIN
// ============================================
// 24-A: Google-only con bootstrap seguro.
// "password" queda nullable y sin uso — código de login por clave común
// retirado (src/app/api/auth/login/route.ts). No se elimina la columna acá
// para no forzar una migración destructiva sobre datos legacy.
// "googleSub" (claim `sub` de Google, @unique) es la única autoridad de
// identidad estable una vez vinculada — el email nunca la reemplaza. La
// unicidad a nivel de base es lo que garantiza que un bootstrap concurrente
// nunca vincule dos filas a la misma identidad de Google.
model SuperAdmin {
  id               String   @id @default(cuid())
  password         String?
  email            String?
  googleSub        String?  @unique
  activo           Boolean  @default(true)
  pushSubscription String?
  createdAt        DateTime @default(now())

  solicitudesRevisionResenaRevisadas SolicitudRevisionResena[]

  @@map("super_admins")
}

// ============================================
// DEUDA HISTORIAL
// ============================================
model DeudaHistorial {
  id            String   @id @default(cuid())
  negocioId     String
  negocioNombre String
  montoAbonado  Float
  deudaAnterior Float
  fechaAbono    DateTime @default(now())
  tipo          String   @default("abono_total")

  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@map("deuda_historial")
}

// ============================================
// SESIONES
// ============================================
model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  userType  String // cliente, negocio, repartidor, superadmin
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sesiones")
}

// ============================================
// RECUPERACIÓN DE CONTRASEÑA (Bugfix-5D)
// ============================================
// Modelo genérico y pequeño — resuelve la cuenta vía userType + userId, sin
// una FK polimórfica hacia cuatro tablas distintas (mismo patrón que ya usa
// Sesion.userType). Nunca guarda el token real: solo su hash SHA-256
// (tokenHash), igual que Sesion.token y que CodigoIncorporacionMozo.codeHash.
// Valores permitidos de userType: cliente | negocio | repartidor |
// cuenta_operativa — nunca superadmin (sin email) ni terminal (no es una
// cuenta personal). El allowlist se valida en la aplicación
// (src/lib/password-reset.ts), no en el schema.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  userType  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userType, userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================
// LOGIN THROTTLE — dimensión por cuenta (AUTH-LOGIN-THROTTLE-HARDENING)
// ============================================
// Tabla mínima, opaca: throttleKey es SHA-256(accountType + ":" +
// normalizedIdentifier) — nunca el email/usuario en claro, nunca password,
// nunca IP (la dimensión IP sigue en memoria de proceso, ver
// src/lib/rate-limit.ts). Cuenta EXCLUSIVAMENTE fallos de login (contraseña
// incorrecta o cuenta inexistente) — nunca intentos exitosos ni estados de
// negocio posteriores (email no verificado, negocio no aprobado/suspendido,
// repartidor inactivo, etc.). Ventana fija: al expirar (resetAt <= now) la
// próxima falla arranca una ventana nueva, igual semántica que RATE_LIMITS
// en src/lib/rate-limit.ts. Sin FK a ninguna cuenta real — el estado
// pertenece únicamente a esta tabla, nunca se refleja como un flag en
// Cliente/Negocio/Repartidor/CuentaOperativa (nunca hay "cuenta bloqueada"
// persistente, sólo un cooldown temporal aquí).
model LoginThrottle {
  throttleKey String   @id @map("throttle_key")
  count       Int      @default(1)
  resetAt     DateTime @map("reset_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("login_throttle")
}

// ============================================
// LÍMITE DE REGISTRO DE CUENTA OPERATIVA (Bugfix-5F)
// ============================================
// Un evento por cada CuentaOperativa creada exitosamente vía
// POST /api/operativo/register (nunca por email duplicado, validación
// fallida, request inválido, error del servidor, ni límite alcanzado — ver
// src/app/api/operativo/register/route.ts). Nunca guarda la IP ni la cookie
// de dispositivo en texto plano: solo su HMAC-SHA256 con un secreto de
// servidor dedicado (src/lib/operativo-registration-limit.ts). Sin FK hacia
// CuentaOperativa a propósito — es un contador de abuso, no una relación de
// dominio.
//
// ipHash es nullable a propósito (corrección posterior a la versión inicial
// de Bugfix-5F): cuando no puede determinarse una IP fiable, NUNCA se hashea
// el valor "unknown" — eso produciría el mismo hash compartido por todos los
// usuarios sin IP detectable, bloqueando globalmente a cualquiera cuya IP no
// pudiera determinarse después de solo 3 registros ajenos. Con ipHash = null,
// el conteo por IP se omite (nunca se cuenta "cuántos eventos tienen
// ipHash = null") y solo se aplica el límite por dispositivo.
model CuentaOperativaRegistro {
  id         String   @id @default(cuid())
  ipHash     String?
  deviceHash String
  createdAt  DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@map("cuenta_operativa_registros")
}

// ============================================
// PROMOCIONES (cached view of discounted products)
// ============================================
model Promocion {
  id             String    @id @default(cuid())
  productoId     String    @unique
  negocioId      String
  negocioSlug    String
  negocioNombre  String
  precioOriginal Float
  precioPromo    Float
  descuento      String // e.g. "20%" or "$500"
  fechaInicio    DateTime  @default(now())
  fechaFin       DateTime?
  activa         Boolean   @default(true)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  negocio  Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@map("promociones")
}

// ============================================
// MESAS (Salón)
// ============================================
model Mesa {
  id         String    @id @default(cuid())
  numero     Int
  nombre     String    @default("") // "Patio 1", "Barra 3", etc.
  zona       String    @default("") // zone grouping (e.g., "Patio", "Adentro")
  forma      String    @default("") // "redonda", "cuadrada", etc.
  capacidad  Int       @default(4)
  activa     Boolean   @default(true)
  negocioId  String
  negocio    Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  empleadoId String? // Mozo asignado a esta mesa
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)

  // P0-D.1: puntero a la ocupación rotativa activa (nullable — la mayoría del
  // tiempo una mesa no tiene ninguna). @unique impide que la misma ocupación
  // sea "la actual" de más de una mesa a la vez. SetNull porque si la
  // ocupación apuntada se borra, la mesa simplemente vuelve a no tener
  // ocupación actual — nunca debe arrastrar el borrado de la Mesa.
  ocupacionActualId String?               @unique
  ocupacionActual   SesionOcupacionMesa?  @relation("MesaOcupacionActual", fields: [ocupacionActualId], references: [id], onDelete: SetNull)
  // Historial completo de ocupaciones de esta mesa (activas, cerradas y
  // futuras) — relación nombrada distinta de la anterior para que Prisma no
  // las confunda (dos relaciones entre los mismos dos modelos).
  ocupaciones       SesionOcupacionMesa[] @relation("MesaOcupacionHistorial")

  @@unique([negocioId, numero])
  @@map("mesas")
}

// ============================================
// OCUPACIÓN DE MESA (P0-D.1 — fundación)
// ============================================
// Sesión rotativa compartida por todos los clientes de una mesa física,
// entre el momento en que alguien escanea el QR estando "inside" de la
// geocerca (P0-C.2, src/lib/mesa-geofence.ts) y el cierre futuro de la mesa
// (P0-D.3, todavía no implementado). El QR físico y su URL
// (/n/{slug}?mesa={numero}) nunca cambian — lo que rota es esta ocupación.
// Cada dispositivo recibe su propia CredencialOcupacionMesa (token opaco,
// hasheado, nunca guardado en claro — mismo patrón que Sesion.token /
// PasswordResetToken.tokenHash / SesionTerminalOperativa.tokenHash), pero
// todos los dispositivos de la mesa comparten la misma SesionOcupacionMesa
// mientras esté activa.
//
// P0-D.1 SOLO abre o reutiliza la ocupación desde la comprobación pública de
// geocerca. Todavía NO exige ni vincula ningún pedido a ella (eso es
// P0-D.2), y todavía NO implementa cierre manual ni expiración automática
// (eso es P0-D.3) — por eso los campos de cierre son nullable y el estado
// inicial siempre es "activa".
model SesionOcupacionMesa {
  id        String @id @default(cuid())
  negocioId String
  mesaId    String

  // activa | cerrada | expirada — string controlado, mismo patrón sin enum
  // Prisma que ya usa el resto del schema (Pedido.estado,
  // TerminalOperativa.estado, Empleado.areaOperativa, etc.).
  estado String @default("activa")

  iniciadaEn        DateTime @default(now())
  ultimaActividadEn DateTime @default(now())

  // Nullable a propósito: P0-D.1 nunca los escribe — quedan preparados para
  // el cierre real de P0-D.3 (cierre por Mozo/Salón/Negocio o expiración).
  cerradaEn      DateTime?
  cerradaPorTipo String?
  motivoCierre   String?
  cerradaPorId   String?

  // P2-T46-R1: único hecho de pago/cierre comercial de esta ocupación.
  // Nullable para no inventar pagos históricos ni backfillear ocupaciones.
  metodoPago            String?
  pagoConfirmadoEn      DateTime?
  pagoConfirmadoPorTipo String?
  pagoConfirmadoPorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negocio      Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  // Relación de historial (muchas ocupaciones por mesa a lo largo del
  // tiempo) — nombrada explícitamente distinta de "MesaOcupacionActual"
  // (el puntero 1:1 en Mesa.ocupacionActualId) para que Prisma no confunda
  // las dos relaciones entre los mismos dos modelos. Cascade: una ocupación
  // no tiene identidad propia sin su mesa.
  mesa         Mesa    @relation("MesaOcupacionHistorial", fields: [mesaId], references: [id], onDelete: Cascade)
  // Lado inverso del puntero "actual" de Mesa — sin fields/references acá,
  // vive en Mesa.ocupacionActualId.
  mesaActualDe Mesa?   @relation("MesaOcupacionActual")

  credenciales CredencialOcupacionMesa[]
  pedidos      Pedido[]

  // P0-D.1A: además de estos índices, la migración versionada
  // (prisma/migrations/20260804000000_add_table_occupancy_sessions) agrega el
  // índice único PARCIAL "sesiones_ocupacion_mesa_mesaId_activa_key" sobre
  // ("mesaId") WHERE estado = 'activa' — la garantía real de "máximo una
  // ocupación activa por mesa" vive ahí, no en Mesa.ocupacionActualId
  // @unique (que solo impide que la misma ocupación sea "la actual" de más
  // de una mesa). Prisma no soporta índices únicos parciales en su DSL
  // (ninguna versión actual, incluida 6.19.2), así que este índice no puede
  // declararse acá — solo existe en el SQL. Deuda: un futuro "db pull" o una
  // migración autogenerada deben preservarlo manualmente.
  @@index([negocioId, estado])
  @@index([mesaId, estado])
  @@index([ultimaActividadEn])
  @@map("sesiones_ocupacion_mesa")
}

// Autorización opaca de UN dispositivo/navegador para UNA ocupación
// concreta. Nunca representa una cuenta de usuario — no tiene nombre, email
// ni teléfono. Una ocupación puede tener varias credenciales (una por
// dispositivo); una credencial pertenece a una sola ocupación.
model CredencialOcupacionMesa {
  id          String @id @default(cuid())
  ocupacionId String

  // Solo se guarda el hash SHA-256 del token real — el token en claro vive
  // únicamente en la cookie HttpOnly del dispositivo, nunca en la base.
  tokenHash String @unique

  emitidaEn         DateTime  @default(now())
  ultimaActividadEn DateTime  @default(now())
  revocadaEn        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: una credencial no tiene ningún significado fuera de su
  // ocupación (mismo patrón que SesionTerminalOperativa → TerminalOperativa).
  ocupacion SesionOcupacionMesa @relation(fields: [ocupacionId], references: [id], onDelete: Cascade)

  @@index([ocupacionId])
  @@map("credenciales_ocupacion_mesa")
}

// ============================================
// EMPLEADOS (Mozos / Personal)
// ============================================
model CuentaOperativa {
  id            String    @id @default(cuid())
  nombre        String
  email         String    @unique
  password      String?
  googleId      String?   @unique
  telefono      String?
  emailVerified DateTime?
  activo        Boolean   @default(true)
  eliminado     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empleados     Empleado[]
  codigosUsados CodigoIncorporacionMozo[]

  @@index([activo, eliminado])
  @@map("cuentas_operativas")
}

model Empleado {
  id               String  @id @default(cuid())
  nombre           String
  codigo           String // código corto para identificar al mozo
  rol              String  @default("mozo") // mozo, cajero, cocinero, admin
  permisos         String  @default("[]") // JSON array: ["gestion_pedidos", "gestion_productos", "gestion_caja", "gestion_empleados"]
  // Área operativa para la futura PWA DeliGO Operaciones. La administra el negocio;
  // el empleado NO puede cambiarla. No reemplaza a `rol`. Valores: sin_asignar|mozo|salon|pyr.
  areaOperativa     String  @default("sin_asignar")
  // Se incrementa cada vez que cambia `areaOperativa` para que la PWA detecte el nuevo contexto.
  asignacionVersion Int     @default(1)
  // Pagos E3: permiso individual de anticipos en efectivo a proveedores (deshabilitado por defecto; límites obligatorios).
  anticipoProveedorHabilitado             Boolean  @default(false)
  anticipoProveedorLimiteOperacionDecimal Decimal? @db.Decimal(12, 2)
  anticipoProveedorLimiteDiarioDecimal    Decimal? @db.Decimal(12, 2)
  // Catálogo: permisos TEMPORALES de carga/edición de productos (deshabilitados por defecto; vigencia controlada por el servidor).
  catalogoHasta       DateTime?
  catalogoCrear       Boolean   @default(false)
  catalogoEditar      Boolean   @default(false)
  catalogoProveedores Boolean   @default(false)
  catalogoPrecios     Boolean   @default(false)
  catalogoCostos      Boolean   @default(false)
  catalogoImportar    Boolean   @default(false)
  // T7-F1: permiso individual para registrar retiros personales de mercadería desde Caja (deshabilitado por defecto).
  retiroPersonalHabilitado Boolean @default(false)
  activo           Boolean @default(true)
  eliminado        Boolean @default(false)
  token            String? // token para notificaciones push
  pushSubscription String? // push subscription JSON for browser notifications
  negocioId        String
  negocio          Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cuentaOperativaId String?
  cuentaOperativa   CuentaOperativa? @relation(fields: [cuentaOperativaId], references: [id], onDelete: SetNull)
  mesas            Mesa[] // Mesas asignadas a este mozo
  codigosIncorporacionObjetivo CodigoIncorporacionMozo[]
  ventasCaja       Venta[] // F10-B0: ventas de Caja registradas por este empleado (F10-B1+)
  turnosCaja       TurnoCaja[] // F10-B2.1: turnos de Caja de los que fue responsable

  // La unicidad vigente de código se mantiene en SQL como índice único parcial
  // (negocioId, codigo) WHERE eliminado = false. Prisma no soporta índices
  // únicos parciales en su DSL; los lookups operativos filtran eliminado=false.
  retirosComoBeneficiario RetiroPersonal[] @relation("RetiroBeneficiarioEmpleado") // T7-F1
  retirosRegistrados      RetiroPersonal[] @relation("RetiroRegistradoPorEmpleado") // T7-F1
  decisionesRecuperoRetiro DecisionRecuperoRetiro[] // T7-F1: decisiones del dueño sobre sus retiros
  @@unique([negocioId, cuentaOperativaId])
  @@index([cuentaOperativaId])
  @@map("empleados")
}

model CodigoIncorporacionMozo {
  id                        String   @id @default(cuid())
  negocioId                 String
  empleadoObjetivoId        String?
  rol                       String   @default("mozo")
  codeHash                  String   @unique
  codePrefix                String   @default("")
  expiresAt                 DateTime
  // Consumo futuro: transaccion atomica solo si usedAt es null,
  // revokedAt es null y expiresAt sigue vigente.
  usedAt                    DateTime?
  usedByCuentaOperativaId   String?
  revokedAt                 DateTime?
  createdAt                 DateTime @default(now())

  negocio                 Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  empleadoObjetivo        Empleado? @relation(fields: [empleadoObjetivoId], references: [id], onDelete: SetNull)
  usedByCuentaOperativa   CuentaOperativa? @relation(fields: [usedByCuentaOperativaId], references: [id], onDelete: SetNull)

  @@index([negocioId, expiresAt])
  @@index([negocioId, revokedAt])
  @@index([empleadoObjetivoId])
  @@index([usedByCuentaOperativaId])
  @@index([rol])
  @@map("codigos_incorporacion_mozo")
}

// Terminal compartida de Operaciones (PC caja, tablet cocina, tablet atención, monitor,
// celular compartido). Tabla física conservada: "terminales_salon" (renombre solo lógico).
// Autorización futura (NO implementada aún):
//   - `areas` + `scopes` son la fuente de verdad. Áreas: salon | pyr (nunca mozo).
//   - Scopes salón: salon.ver, salon.pedidos.ver, salon.pedidos.cambiar_estado,
//       salon.pedidos.marcar_entregado, salon.mesas.liberar, salon.mesas.reasignar,
//       salon.historial.ver, salon.estadisticas.ver
//   - Scopes PyR: pyr.ver, pyr.pedidos.ver, pyr.pedidos.gestionar, pyr.resenas.ver,
//       pyr.resenas.responder, pyr.mensajes.ver, pyr.mensajes.responder
//   - `perfil` es solo una etiqueta/preset para la UI.
//   - Una terminal NUNCA recibe permisos de administrador ni de delivery de repartidores.
model TerminalOperativa {
  id               String    @id @default(cuid())
  negocioId        String
  nombre           String    @default("Terminal Operativa") // nombre visible del dispositivo
  estado           String    @default("pendiente") // pendiente|activo|revocado; la revocación efectiva se hace vía revokedAt
  perfil           String    @default("pantalla") // etiqueta/preset para UI (no autoriza por sí solo)
  areas            String    @default("[]") // JSON array — áreas permitidas (salon|pyr); fuente de verdad
  scopes           String    @default("[]") // JSON array — fuente de verdad de autorización (deny-by-default)
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  negocio       Negocio                        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  sesiones      SesionTerminalOperativa[]
  vinculaciones VinculacionTerminalOperativa[]

  @@index([negocioId, estado])
  @@index([negocioId, revokedAt])
  @@index([lastUsedAt])
  @@map("terminales_salon")
}

model VinculacionTerminalOperativa {
  id        String   @id @default(cuid())
  negocioId String
  terminalSalonId String? // columna física conservada ("terminalSalonId"); emparejamiento → terminal
  codeHash  String   @unique
  codePrefix String  @default("")
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  negocio           Negocio            @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  terminalOperativa TerminalOperativa? @relation(fields: [terminalSalonId], references: [id], onDelete: Cascade)

  @@index([negocioId, expiresAt])
  @@index([negocioId, revokedAt])
  @@index([usedAt])
  @@index([terminalSalonId])
  @@map("vinculaciones_terminal_salon")
}

model SesionTerminalOperativa {
  id              String   @id @default(cuid())
  terminalSalonId String   // columna física conservada ("terminalSalonId")
  tokenHash       String   @unique
  expiresAt       DateTime
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  terminalOperativa TerminalOperativa @relation(fields: [terminalSalonId], references: [id], onDelete: Cascade)

  @@index([terminalSalonId, revokedAt])
  @@index([expiresAt])
  @@index([lastUsedAt])
  @@map("sesiones_terminal_salon")
}

// ============================================
// CONFIG PLATAFORMA
// ============================================
model ConfigPlataforma {
